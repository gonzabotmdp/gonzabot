def _fresh_queue_snapshot() -> str:
    """Squeue/sinfo recién consultados (no el de INFO EN VIVO, que puede ser
    de hace rato) — liviano a propósito, solo para la regla de optimización
    según estado real de la cola (ver core.txt)."""
    parts = []
    try:
        r = subprocess.run(
            ["squeue", "-o", "%i %P %j %u %T %.10M %D %R", "--noheader"],
            capture_output=True, text=True, timeout=8)
        out = r.stdout.strip()
        if len(out) > 1500:
            out = out[:1500] + "... [truncado]"
        parts.append(f"[squeue cluster-wide, recién consultado]\n{out or '(vacío, sin jobs en cola)'}")
    except Exception:
        pass
    try:
        r = subprocess.run(["sinfo", "-o", "%P %a %D %t", "--noheader"],
                            capture_output=True, text=True, timeout=8)
        out = r.stdout.strip()
        if len(out) > 500:
            out = out[:500] + "... [truncado]"
        parts.append(f"[sinfo (particion/nodos/estado), recién consultado]\n{out}")
    except Exception:
        pass
    if not parts:
        return ""
    return ("\n\n--- ESTADO ACTUAL DE LA COLA (recién consultado, no esperes "
            "más info al usuario, ya la tenés acá) ---\n" + "\n\n".join(parts)
            + "\n--- FIN ESTADO ACTUAL DE LA COLA ---")


