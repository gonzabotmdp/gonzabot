def _detect_filename(lang: str, body: str, title: str) -> "str | None":
    """Deduce el nombre de archivo de un bloque (para /saveall y pie #REF).

    El título (texto previo al bloque) puede enumerar VARIOS archivos — solo
    aceptar un candidato cuya extensión sea coherente con el contenido del
    bloque, priorizando el más cercano (el último mencionado)."""
    b = body.lstrip()
    ok_exts = _EXT_FOR_LANG.get((lang or "").lower())
    # El contenido manda sobre la etiqueta del fence (el modelo la pifia seguido)
    if "__global__" in body[:3000] or b.startswith("#include"):
        ok_exts = {"cu", "cpp", "c", "h", "hpp"}
    elif b.startswith("#!/bin/bash") or b.startswith("#SBATCH"):
        ok_exts = {"sh", "sbatch"}
    elif b.startswith(("import ", "from ", "def ", "#!")) and "python" in (lang or "").lower():
        ok_exts = {"py"}
    for c in reversed(_FNAME_RE.findall(title or "")):
        if ok_exts is None or c.rpartition(".")[2] in ok_exts:
            return c
    if b.startswith("#!/bin/bash") or b.startswith("#SBATCH"):
        jm = re.search(r'--job-name[= ]([\w\-]+)', body)
        return f"{jm.group(1)}.sbatch" if jm else None
    return None


def _saveall_names(blocks: "list[tuple[str, str, str]]") -> "list[str]":
    """Nombre final por bloque: detectado, o refN.ext por lenguaje; sin duplicados."""
    names: list[str] = []
    for i, (lang, body, title) in enumerate(blocks):
        name = _detect_filename(lang, body, title)
        if not name:
            ext = _LANG_EXT.get((lang or "").lower(), "txt")
            if ext == "sh" and ("#SBATCH" in body):
                ext = "sbatch"
            if "__global__" in body[:3000]:
                ext = "cu"
            name = f"ref{i+1}.{ext}"
        base = name
        n = 2
        while name in names:
            stem, _, ext = base.rpartition(".")
            name = f"{stem}_{n}.{ext}" if stem else f"{base}_{n}"
            n += 1
        names.append(name)
    return names


