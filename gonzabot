def _handle_runtime_error(e: Exception) -> None:
    """Muestra error de stream_response de forma amigable."""
    err_s = str(e)
    if "__GARBAGE" in err_s:
        sys.stdout.write("\r\x1b[2K")
        sys.stdout.flush()
        if _console:
            _console.print("\n[yellow]↺ Respuesta inválida — intentá reformular la pregunta.[/yellow]\n")
        else:
            print(_c(YEL, "\n↺ Respuesta inválida — intentá reformular la pregunta.\n"))
    else:
        print(_c(RED, f"\nError: {err_s}\n"))


def _raw_input(prompt: str) -> str:
    """Line reader en raw mode con status bar fija y detección de bracketed paste."""
    if not sys.stdin.isatty():
        return input(prompt)
    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
    except Exception:
        return input(prompt)

    def _show_paste_and_ask(lines: list[str]) -> str:
        """Muestra preview del paste y lee contexto opcional. Retorna texto final."""
        cols = shutil.get_terminal_size().columns
        n = len(lines)
        _is_sbatch = any("#SBATCH" in l for l in lines)
        # Preview: primeras 3 líneas (solo si no es sbatch)
        if _is_sbatch:
            sys.stdout.write(f"\r\x1b[2K{prompt}\x1b[2m[sbatch · {n} líneas — s para someter, Enter para analizar]\x1b[0m\r\n")
        else:
            sys.stdout.write(f"\r\x1b[2K{prompt}\x1b[2m[pegado: {n} {'línea' if n == 1 else 'líneas'}]\x1b[0m\r\n")
            sys.stdout.write(f"  \x1b[36m+\x1b[0m \x1b[2m(Enter para enviar, o escribí tu pregunta)\x1b[0m\r\n")
        sys.stdout.write(f"  \x1b[36m❯\x1b[0m ")
        sys.stdout.flush()
        # Leer línea adicional en raw mode (con manejo de escape sequences y bracketed paste)
        extra_buf: list[str] = []
        _ep_esc = ""
        while True:
            try:
                ch = os.read(fd, 1).decode("utf-8", errors="replace")
            except Exception:
                break
            # Acumular secuencias de escape
            if _ep_esc:
                _ep_esc += ch
                if _ep_esc == "\x1b[200~":
                    # Bracketed paste en el extra prompt — leer contenido completo
                    _ep_esc = ""
                    _ep_pbuf: list[str] = []
                    _ep_pesc = ""
                    while True:
                        try:
                            _ep_c = os.read(fd, 256).decode("utf-8", errors="replace")
                        except Exception:
                            break
                        if not _ep_c:
                            break
                        _ep_done = False
                        for _ep_p in _ep_c:
                            _ep_pesc = (_ep_pesc + _ep_p)[-6:]
                            if _ep_pesc.endswith("\x1b[201~"):
                                _ep_pbuf = _ep_pbuf[:-5]
                                _ep_done = True
                                break
                            _ep_pbuf.append(_ep_p)
                        if _ep_done:
                            break
                    # Usar primera línea del paste como pregunta
                    _ep_text = "".join(_ep_pbuf).replace("\r\n", "\n").split("\n")[0].strip()
                    for _ec in _ep_text:
                        if _ec >= " ":
                            extra_buf.append(_ec)
                            sys.stdout.write(_ec)
                    sys.stdout.flush()
                elif len(_ep_esc) >= 3 and (ch.isalpha() or ch == "~"):
                    _ep_esc = ""   # secuencia desconocida — ignorar
                elif len(_ep_esc) == 2 and ch not in ("[", "O"):
                    _ep_esc = ""
                continue
            if ch in ("\r", "\n"):
                sys.stdout.write("\r\n")
                sys.stdout.flush()
                break
            elif ch in ("\x7f", "\x08"):
                if extra_buf:
                    extra_buf.pop()
                    sys.stdout.write("\x08 \x08")
                    sys.stdout.flush()
            elif ch == "\x1b":
                _ep_esc = ch
            elif ch == "\x03":
                raise KeyboardInterrupt
            elif ch == "\x04":
                raise EOFError
            elif ch >= " ":
                extra_buf.append(ch)
                sys.stdout.write(ch)
                sys.stdout.flush()
        paste_text = "\n".join(lines).strip()
        extra = "".join(extra_buf).strip()
        if _SB_ACTIVE:
            _sb_draw()
        if _is_sbatch and extra.lower() == "s":
            import tempfile as _tf
            # Reconstruir desde lines para evitar artefactos del .strip()
            sb_text = "\n".join(lines)
            if not sb_text.startswith("#!"):
                sb_text = "#!/bin/bash\n" + sb_text.lstrip("\n")
            tmp = _tf.NamedTemporaryFile(suffix=".sh", delete=False, mode="w")
            tmp.write(sb_text + "\n")
            tmp.close()
            try:
                r = subprocess.run(["sbatch", tmp.name], capture_output=True, text=True)
                out = r.stdout.strip() or r.stderr.strip()
                color = GRN if r.returncode == 0 else RED
                sys.stdout.write(f"\r\n  {_c(color, out)}\r\n")
                sys.stdout.flush()
            except FileNotFoundError:
                sys.stdout.write(_c(RED, "\r\n  sbatch no disponible en este nodo.\r\n"))
                sys.stdout.flush()
            finally:
                try:
                    Path(tmp.name).unlink(missing_ok=True)
                except Exception:
                    pass
            return ""
        if extra:
            return extra + "\n\n" + paste_text
        return paste_text

    def _paint(buf, cur=None):
        """Redibuja la línea del prompt, manejando wrap visual multi-línea."""
        import re as _re_p
        line = "".join(buf)
        if cur is None:
            cur = len(buf)
        cols = shutil.get_terminal_size().columns
        prompt_vis = len(_re_p.sub(r'\x1b\[[0-9;]*m', '', prompt))
        # Cuántas líneas visuales ocupa el contenido actual
        wrap_lines = max(0, (prompt_vis + len(line) - 1) // cols)
        move_up = f"\x1b[{wrap_lines}A" if wrap_lines > 0 else ""
        # \x1b[J = borrar desde cursor hasta fin de pantalla (limpia todas las líneas del input)
        sys.stdout.write(f"{move_up}\r\x1b[J{prompt}{line}")
        # Posicionar cursor en `cur` (retroceder desde el final)
        back = len(buf) - cur
        if back > 0:
            sys.stdout.write(f"\x1b[{back}D")
        sys.stdout.flush()

    # Historial readline para ↑↓
    try:
        n_h = readline.get_current_history_length()
        _hist = [readline.get_history_item(i) for i in range(1, n_h + 1)] + [""]
    except Exception:
        _hist = [""]
    _hi = len(_hist) - 1

    buf: list[str] = []
    cur = 0          # posición del cursor dentro de buf
    esc = ""
    result = None

    # Raw mode ANTES de habilitar bracketed paste y mostrar el prompt
    # para que echo esté deshabilitado cuando llegue el paste
    tty.setraw(fd)
    sys.stdout.write("\x1b[?2004h")
    sys.stdout.flush()
    _paint(buf, cur)
    if _SB_ACTIVE:
        _sb_draw()   # restaurar status bar después del paint (por si \x1b[J lo borró)
    try:
        _pre = "".join(_ESC_PASTE_PENDING)
        _ESC_PASTE_PENDING.clear()
        while result is None:
            try:
                if _pre:
                    ch, _pre = _pre, ""
                else:
                    ch = os.read(fd, 32).decode("utf-8", errors="replace")
            except Exception:
                break

            for _ci, c in enumerate(ch):
                if esc:
                    esc += c
                    # \x1b[ = CSI (flechas normales, bracketed paste)
                    # \x1bO = SS3 (flechas en modo aplicación — algunos terminales SSH)
                    if len(esc) == 2 and c not in ("[", "O"):
                        esc = ""   # secuencia desconocida — ignorar
                        continue
                    if len(esc) >= 3 and (c.isalpha() or c == "~"):
                        seq, esc = esc, ""
                        if seq == "\x1b[200~":
                            # ── Bracketed paste ─────────────────────────────
                            _bp_leftover = ch[_ci + 1:]
                            pbuf: list[str] = []
                            pesc = ""   # ventana deslizante últimos 6 chars
                            import select as _sel_bp
                            found = False
                            # Procesar leftover primero (misma lectura que el start marker)
                            for p in _bp_leftover:
                                pesc = (pesc + p)[-6:]
                                if pesc.endswith("\x1b[201~"):
                                    pbuf = pbuf[:-5]
                                    found = True
                                    break
                                pbuf.append(p)
                            # Si el end marker no estaba en el leftover, leer del fd
                            if not found:
                                while True:
                                    try:
                                        if not _sel_bp.select([sys.stdin], [], [], 2.0)[0]:
                                            break  # timeout 2s — end marker nunca llegó
                                        pc = os.read(fd, 4096).decode("utf-8", errors="replace")
                                    except Exception:
                                        break
                                    if not pc:
                                        break
                                    for p in pc:
                                        pesc = (pesc + p)[-6:]
                                        if pesc.endswith("\x1b[201~"):
                                            pbuf = pbuf[:-5]
                                            found = True
                                            break
                                        pbuf.append(p)
                                    if found:
                                        break
                            content = "".join(pbuf).replace("\r\n", "\n").replace("\r", "\n")
                            lines = content.split("\n")
                            while lines and not lines[-1].strip():
                                lines.pop()
                            if len(lines) <= 1:
                                sys.stdout.write("\r\n")
                                sys.stdout.flush()
                                result = lines[0].strip() if lines else ""
                            else:
                                result = _show_paste_and_ask(lines)
                            break  # salir del for loop — el leftover ya fue procesado
                        elif seq in ("\x1b[A", "\x1bOA"):   # ↑ historial (CSI y SS3)
                            if _hi > 0:
                                if _hi == len(_hist) - 1:
                                    _hist[-1] = "".join(buf)
                                _hi -= 1
                                buf[:] = list(_hist[_hi])
                                cur = len(buf)
                                _paint(buf, cur)
                                _sb_draw()
                        elif seq in ("\x1b[B", "\x1bOB"):   # ↓ historial (CSI y SS3)
                            if _hi < len(_hist) - 1:
                                _hi += 1
                                buf[:] = list(_hist[_hi])
                                cur = len(buf)
                                _paint(buf, cur)
                                _sb_draw()
                        elif seq in ("\x1b[C", "\x1bOC"):   # → derecha
                            if cur < len(buf):
                                cur += 1
                                sys.stdout.write("\x1b[C")
                                sys.stdout.flush()
                        elif seq in ("\x1b[D", "\x1bOD"):   # ← izquierda
                            if cur > 0:
                                cur -= 1
                                sys.stdout.write("\x1b[D")
                                sys.stdout.flush()
                        elif seq in ("\x1b[H", "\x1bOH", "\x1b[1~"):  # Home
                            cur = 0
                            _paint(buf, cur)
                        elif seq in ("\x1b[F", "\x1bOF", "\x1b[4~"):  # End
                            cur = len(buf)
                            _paint(buf, cur)
                        elif seq == "\x1b[3~":              # Delete
                            if cur < len(buf):
                                buf.pop(cur)
                                _paint(buf, cur)
                    continue

                if c == "\x1b":
                    esc = c
                elif c in ("\r", "\n"):
                    # Fallback paste detection: si hay más datos esperando
                    # inmediatamente después del \n, es un paste sin bracketed paste mode
                    import select as _sel
                    if _sel.select([sys.stdin], [], [], 0)[0]:
                        # Leer todo el paste — 0.50s idle para tolerar gaps SSH/tmux
                        paste_chars = list(buf) + ["\n"]
                        while _sel.select([sys.stdin], [], [], 0.50)[0]:
                            try:
                                extra = os.read(fd, 4096).decode("utf-8", errors="replace")
                                if not extra:
                                    break
                                paste_chars.extend(extra)
                            except Exception:
                                break
                        content = "".join(paste_chars).replace("\r\n", "\n").replace("\r", "\n")
                        lines = content.split("\n")
                        while lines and not lines[-1].strip():
                            lines.pop()
                        if len(lines) <= 1:
                            sys.stdout.write("\r\n")
                            sys.stdout.flush()
                            result = lines[0].strip() if lines else ""
                        else:
                            result = _show_paste_and_ask(lines)
                    else:
                        sys.stdout.write("\r\n")
                        sys.stdout.flush()
                        result = "".join(buf).strip()
                elif c in ("\x7f", "\x08"):    # Backspace
                    if cur > 0:
                        buf.pop(cur - 1)
                        cur -= 1
                        _paint(buf, cur)
                elif c == "\x03":              # Ctrl-C
                    sys.stdout.write(f"\r\x1b[2K{prompt}^C\r\n")
                    sys.stdout.flush()
                    raise KeyboardInterrupt
                elif c == "\x04":              # Ctrl-D (buffer vacío)
                    if not buf:
                        sys.stdout.write("\r\n")
                        sys.stdout.flush()
                        raise EOFError
                elif c == "\x0c":              # Ctrl-L: limpiar pantalla + restaurar scroll region
                    _c2, _r2 = shutil.get_terminal_size()
                    sys.stdout.write(f"\x1b[2J\x1b[H\x1b[1;{_r2 - 2}r")
                    sys.stdout.flush()
                    _paint(buf, cur)
                    _sb_draw()
                elif c == "\x15":              # Ctrl-U: borrar hasta inicio
                    del buf[:cur]
                    cur = 0
                    _paint(buf, cur)
                elif c == "\x17":              # Ctrl-W: borrar palabra antes del cursor
                    while cur > 0 and buf[cur - 1] == " ":
                        buf.pop(cur - 1); cur -= 1
                    while cur > 0 and buf[cur - 1] != " ":
                        buf.pop(cur - 1); cur -= 1
                    _paint(buf, cur)
                elif c == "\x0b":              # Ctrl-K: borrar hasta fin
                    del buf[cur:]
                    _paint(buf, cur)
                elif ord(c) >= 32:
                    buf.insert(cur, c)
                    cur += 1
                    if cur == len(buf):
                        sys.stdout.write(c)    # echo directo si cursor al final
                        sys.stdout.flush()
                    else:
                        _paint(buf, cur)       # repintar si insertamos en el medio

    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        except Exception:
            pass
        sys.stdout.write("\x1b[?2004l")
        sys.stdout.flush()

    result = result or ""
    if result:
        try:
            readline.add_history(result)
        except Exception:
            pass
    return result


# ── Usage stats ───────────────────────────────────────────────────────────────
def _log_event(event: str, **kwargs):
    try:
        STATS_LOG.parent.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass
    try:
        STATS_LOG.parent.chmod(0o777)
    except OSError:
        pass
    try:
        entry = {"ts": datetime.now().isoformat(timespec="seconds"),
                 "user": _USERNAME, "event": event, **kwargs}
        with STATS_LOG.open("a") as f:
            f.write(json.dumps(entry) + "\n")
        try:
            STATS_LOG.chmod(0o666)
        except OSError:
            pass
    except OSError:
        pass


