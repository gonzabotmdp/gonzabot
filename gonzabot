                    # separado por --reasoning-parser) gastan buena parte del budget PENSANDO antes
                    # de emitir el diff real en "content" — confirmado en vivo 30/8: con 8000,
                    # reasoning_content llegó a 18K+ caracteres y "content" volvía vacío o cortado
                    # a mitad del Branch 2/3. 8000 alcanza de sobra para modelos sin razonamiento
                    # (Qwen no lo usa igual, termina antes por su cuenta) — no genera costo extra
                    # real, solo levanta el techo para el caso que lo necesita.
                    reply_br = stream_response(messages_br, max_tokens=24000, check_garbage=False)
                except RuntimeError as e:
