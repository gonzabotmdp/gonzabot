# Modelos con reasoning-parser propio (--reasoning-parser en su sbatch de vLLM)
# donde confirmamos en vivo (30/8) que el modelo a veces NO emite el token
# especial <think> como su primer token generado -- cuando eso pasa, el parser
# de vLLM (glm4_moe_reasoning_parser.py, rama "thinking is disabled") nunca ve
# el token_id esperado y deja "<think>" como texto crudo en el campo content
# que gonzabot renderiza. Medido: ~50% de las veces a ~17K tokens de contexto
# real. Fix que SÍ funciona (14/14 en tests): forzar el prefijo "<think>\n" vía
# continue_final_message le saca al modelo la decisión ambigua de "abro
# razonamiento o no".
_REASONING_MODELS = {"glm45-air"}


def _build_request(messages: list[dict], max_tokens: int = 8000) -> Request:
    # temperature bajada de 0.6 a 0.3 (rango recomendado para generación de comandos/paths
    # exactos, ver discusión 23/8 — gonzabot genera sbatch/rutas/hashes la mayor parte del
    # tiempo, no charla creativa). top_p/top_k agregados: faltaban del todo, sin ellos vLLM
    # usa su propio default (mas permisivo que lo que Qwen valido) — estos son los valores
    # oficiales del generation_config.json de Qwen2.5-72B-Instruct.
    body = {
        "model":    MODEL,
        "messages": messages,
        "stream":   True,
        "temperature": 0.3,
        "top_p": 0.8,
        "top_k": 20,
        "repetition_penalty": 1.1,
        "max_tokens": max_tokens,
    }
    if MODEL in _REASONING_MODELS and messages and messages[-1].get("role") != "assistant":
        body["messages"] = list(messages) + [{"role": "assistant", "content": "<think>\n"}]
        body["continue_final_message"] = True
        body["add_generation_prompt"] = False
    payload = json.dumps(body).encode("utf-8")
    return Request(
        f"{VLLM_BASE}/chat/completions",
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Accept":        "text/event-stream",
        },
        method="POST",
    )


def _touch_heartbeat():
    try:
        HEARTBEAT.touch()
    except OSError:
        pass


def _auto_start_service() -> bool:
    """Drop a start-request flag and wait for the cron to bring the service up."""
    import itertools, time
    fuera = _fuera_de_horario()
    if fuera:
        print(_c(YEL, f"\n▶ {fuera}"))
        return False
    print(_c(YEL, "\n▶ El servicio no está corriendo."))
    resp = _yn_raw(_c(BOLD, "  ¿Pedirle al sistema que lo inicie? (demora ~2 min) [s/N]: "))
    if not resp:
        return False
    try:
        START_REQUEST.write_text(f"{_USERNAME}\n")
        _log_event("service_request")
    except OSError as e:
        print(_c(RED, f"  No se pudo crear el pedido: {e}"))
        return False
    print(_c(DIM, "  Pedido enviado. Esperando que el servicio levante..."))

    spinner = itertools.cycle(["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"])
    for i in range(30):  # hasta 5 min
        time.sleep(10)
        elapsed = (i + 1) * 10
        mins, secs = divmod(elapsed, 60)
        label = f"{mins}m{secs:02d}s" if mins else f"{secs}s"
        print(f"  {_c(CYAN, next(spinner))} {label}", flush=True)
        if _check_online():
            _touch_heartbeat()
            print(_c(GRN, f"  ✓ Listo en {label}. Respondiendo..."))
            return True
    print(_c(RED, "  Timeout esperando el servicio. Intentar más tarde."))
    return False


def stream_response(messages: list[dict], max_tokens: int = 8000, silent: bool = False,
                    check_garbage: bool = True) -> str:
    """Stream chat completion; print tokens as they arrive; return full text.
    If silent=True, buffer output and only print at the end (for /compact etc.).
    If check_garbage=False, skip garbage detection (for large code generation tasks)."""
    import itertools, time, threading
    global _LAST_CODE_BLOCKS
    # NO limpiar _LAST_CODE_BLOCKS acá: si esta respuesta no trae bloques
    # (ej. comentario a un sbatch fallido), los #REF anteriores deben sobrevivir
    # para que /save N siga funcionando (bug reparado 13 jul 2026)
    _touch_heartbeat()
    chars_in = sum(len(m.get("content","")) for m in messages if m["role"]=="user")
    req = _build_request(messages, max_tokens=max_tokens)
    try:
        resp: HTTPResponse = urlopen(req, timeout=120)
    except HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"vLLM HTTP {e.code}: {body}") from e
    except URLError as e:
        raise RuntimeError(f"No se puede conectar a {VLLM_BASE}\n"
                           "  ¿Está corriendo el servicio? Verificar con: squeue | grep vllm") from e

    # Spinner visible durante el TTFT (hasta que llega el primer token)
    first_token = threading.Event()
    spin_chars = itertools.cycle(["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"])
    t0 = time.time()

    stop        = threading.Event()  # para los threads (siempre se setea al final)
    user_aborted = threading.Event()  # solo si el usuario apretó ESC o Ctrl-C

    def _spin():
        if silent:
            return
        if _console is not None:
            while not first_token.wait(0.08):
                if stop.is_set():
                    break
                frame = next(spin_chars)
                elapsed = time.time() - t0
                if _lv[0] is not None:
                    st = _RichText()
                    st.append(f"  {frame} ", style="cyan")
                    st.append(f"generando… {elapsed:.1f}s", style="dim")
                    _lv[0].update(st)
        else:
            while not first_token.wait(0.08):
                if stop.is_set():
                    break
                elapsed = time.time() - t0
                frame = next(spin_chars)
                print(f"\r  {_c(CYAN, frame)} {elapsed:.1f}s", end="", flush=True)

    def _esc_watch():
        import termios, tty, select as _sel_esc
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setcbreak(fd)
            while not stop.is_set():
                try:
                    ready = _sel_esc.select([sys.stdin], [], [], 0.05)[0]
                except OSError:
                    continue
                if not ready:
                    continue
                ch = os.read(fd, 1).decode("utf-8", errors="replace")
                if ch == "\x1b":
                    try:
                        has_more = _sel_esc.select([sys.stdin], [], [], 0.08)[0]
                    except OSError:
                        has_more = False
                    if has_more:
                        rest = os.read(fd, 1).decode("utf-8", errors="replace")
                        if rest in ("[", "O"):
                            seq_tail = ""
                            try:
                                while _sel_esc.select([sys.stdin], [], [], 0.05)[0]:
                                    c2 = os.read(fd, 1).decode("utf-8", errors="replace")
                                    seq_tail += c2
                                    if c2.isalpha() or c2 == "~":
                                        break
                            except OSError:
                                pass
                            if seq_tail.startswith("200"):
                                # Bracketed paste durante streaming → avisar y drenar
                                sys.stdout.write("\r\x1b[K  ⚠ Paste recibido — esperá que termine (ESC para cancelar)\r\n")
                                sys.stdout.flush()
                                pbuf = ""
                                try:
                                    while _sel_esc.select([sys.stdin], [], [], 0.3)[0]:
                                        pbuf += os.read(fd, 256).decode("utf-8", errors="replace")
                                        if "\x1b[201~" in pbuf:
                                            break
                                except OSError:
                                    pass
                        continue
                    user_aborted.set()
                    stop.set()
                    break
                else:
                    # Tecla normal durante streaming → avisar
                    sys.stdout.write("\r\x1b[K  ⚠ Esperá que termine — ESC para cancelar\r\n")
                    sys.stdout.flush()
        except Exception:
            pass
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)

    spin_thread = threading.Thread(target=_spin, daemon=True)
    esc_thread  = threading.Thread(target=_esc_watch, daemon=True)
    spin_thread.start()
    esc_thread.start()

    def _is_garbage_early(t: str) -> bool:
        n = len(t)
        if n < 10:
            return False
        # Chars raros en texto ES/EN normal
        if t.count("\\")  > n * 0.25: return True
        if t.count("\x00")> n * 0.05: return True
        if t.count("➤")   > n * 0.08: return True
        if t.count("❖")   > n * 0.08: return True
        if t.count(";")   > n * 0.15: return True
        if t.count(" ")   > n * 0.70: return True   # línea casi vacía
        # Scripts no-latinos (CJK, hebreo, hangul, dingbats, emoji)
        unusual = sum(1 for c in t if
            '✀' <= c <= '➿' or   # Dingbats
            '一' <= c <= '鿿' or   # CJK
            '֐' <= c <= '׿' or   # Hebreo
            '가' <= c <= '퟿' or   # Hangul
            c >= '\U0001F000')             # Emoji+
        return unusual > n * 0.05

    full_text = []
    _raw_buf: list[str] = []   # tokens crudos del LLM → para markdown re-render
    _lv: list = [None, None]   # [live_instance, current_RichText]
    if _console is not None and not silent:
        _lv[1] = _RichText()
        _lv[0] = _RichLive(_lv[1], console=_console, refresh_per_second=10,
                            transient=True, vertical_overflow="visible")
        _lv[0].start()
    buf = b""
    got_first = False
    _early_gb_checked = False
    _early_gb_lines   = 0   # líneas chequeadas al inicio
    _roll_buf         = ""  # buffer rolling para chequeo continuo post-early
    _roll_tok         = 0   # contador de tokens post-early check
    line_buf        = ""
    in_code         = False
    in_explain      = False
    just_closed     = False   # True justo después de cerrar un ```
    pending_intro   = None    # línea "xxx:" buffereada esperando confirmación

    # rich: bloques de código bufferizados para renderizar al final
    _rich_blocks: "list[tuple[str,list[str],str]]" = []   # [(lang, [lines], title)]
    _cur_lang     = ""
    _cur_lines:   "list[str]" = []
    _cur_title    = ""   # texto antes del bloque (para #REF)
    _last_prose   = ""   # última línea de prosa emitida
    _prose_acc:    "list[str]" = []   # líneas de prosa acumuladas para unir en párrafo

    import re as _re
    _EXPL_START  = _re.compile(r'^\d+\.\s+\*\*')        # "1. **Texto**"
    _EXPL_ITEM   = _re.compile(r'^\s+-\s+[`*]')          # "   - `código`" o "   - *txt*"
    _EXPL_BULLET = _re.compile(r'^\s*-\s+`[^`]+`\s*:')

    _screen_lines_after_early = 0   # líneas emitidas después del early check

    def _emit(text: str):
        nonlocal _screen_lines_after_early
        if text:
            if not silent:
                if _lv[0] is not None:
                    _lv[1].append(text)
                    _lv[0].update(_lv[1])
                elif _console is not None:
                    _console.print(text, end="", markup=False, highlight=False)
                else:
                    print(text, end="", flush=True)
                if _early_gb_checked:
                    _screen_lines_after_early += text.count("\n")
            full_text.append(text)

    def _flush_pending():
        nonlocal pending_intro
        if pending_intro is not None:
            _emit(pending_intro + "\n")
            pending_intro = None

    def _flush_line(line: str):
        nonlocal in_code, in_explain, just_closed, pending_intro
        nonlocal _cur_lang, _cur_lines, _cur_title, _last_prose
        stripped = line.lstrip()

        # Detectar apertura/cierre de bloque de código
        if stripped.startswith("```"):
            if in_code:
                in_code = False
                just_closed = True
                in_explain = False
                if _console is not None:
                    full_text.append(line + "\n")  # mantener en full_text para /save /diff /edit
                    _rich_blocks.append((_cur_lang, list(_cur_lines), _cur_title))
                    _cur_lines = []
                    _cur_lang = ""
                    _cur_title = ""
                else:
                    _rich_blocks.append((_cur_lang, list(_cur_lines), _cur_title))
                    _cur_lines = []
                    _cur_lang = ""
                    _cur_title = ""
                    _emit(line + "\n")
            else:
                in_code = True
                just_closed = False
                # El título es el pending_intro (línea "algo:") o la última línea de prosa
                _cur_title = (pending_intro or _last_prose or "").strip().rstrip(":")
                _last_prose = ""    # consumido; evitar reutilización en bloques consecutivos
                pending_intro = None  # ídem
                if _prose_acc:   # flush prosa acumulada antes del bloque de código
                    _emit(" ".join(_prose_acc) + "\n")
                    _prose_acc.clear()
                _flush_pending()
                if _console is not None:
                    full_text.append(line + "\n")  # mantener en full_text
                    _cur_lang = stripped[3:].strip()
                else:
                    _cur_lang = stripped[3:].strip()
                    _emit(line + "\n")
            return

        if in_code:
            if _console is not None:
                _cur_lines.append(line)
                full_text.append(line + "\n")  # mantener en full_text para /save /diff /edit
            else:
                _emit(line + "\n")
            return

        # Fuera de código: filtrar headers
        if stripped.startswith("#"):
            return

        # Inicio de lista explicativa (1. **Bold** o - `code`: desc)
        if _EXPL_START.match(stripped) or _EXPL_BULLET.match(stripped):
            in_explain = True
            pending_intro = None
            return

        # Dentro de bloque explicativo
        if in_explain:
            if not stripped or _EXPL_ITEM.match(stripped) or _EXPL_BULLET.match(stripped) or stripped.startswith("-"):
                return
            in_explain = False   # salimos del bloque
            just_closed = False

        # Resolver pending_intro: si llega contenido real, flush; si es blank, hold
        if pending_intro is not None:
            if not stripped:
                return   # línea vacía entre intro y lista → seguir esperando
            _flush_pending()   # hay contenido real → el intro es legítimo

        # Bufferear línea-colon post-código como posible intro de explicación
        # (just_closed persiste a través de líneas vacías)
        if just_closed and stripped:
            if stripped.endswith(":"):
                pending_intro = line
                return
            just_closed = False   # primer contenido real sin ":" termina la ventana

        if stripped:
            _last_prose = stripped
            _prose_acc.append(stripped)   # acumular para emitir como párrafo continuo
        else:
            if _prose_acc:
                _emit(" ".join(_prose_acc) + "\n")
                _prose_acc.clear()
            _emit("\n")

    try:
        while not stop.is_set():
            chunk = resp.read(STREAM_CHUNK)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                line = line.strip()
                if not line or line == b"data: [DONE]":
                    continue
                if line.startswith(b"data: "):
                    try:
                        obj = json.loads(line[6:])
                        delta = obj["choices"][0]["delta"]
                        token = delta.get("content", "").replace("\x00", "")
                        if token:
                            _raw_buf.append(token)
                            if not got_first:
                                first_token.set()
                                spin_thread.join(timeout=0.2)
                                if not silent:
                                    if _lv[0] is not None:
                                        _lv[1] = _RichText()
                                        _lv[1].append("▶ ", style="cyan")
                                        _lv[0].update(_lv[1])
                                    elif _console is not None:
                                        _console.print("[cyan]▶[/cyan] ", end="")
                                    else:
                                        sys.stdout.write(f"\r\x1b[2K")
                                        sys.stdout.flush()
                                        print(_c(CYAN, "▶ "), end="", flush=True)
                                got_first = True
                            if not _early_gb_checked:
                                # Fase inicial: bufferear para chequeo de garbage
                                line_buf += token
                                if len(line_buf) > 120:
                                    # Buffer sin newline largo → chequear y pasar a buffering-por-líneas
                                    _early_gb_checked = True
                                    if check_garbage and _is_garbage_early(line_buf):
                                        raise RuntimeError("__GARBAGE__")
                                    # Flush líneas completas; dejar fragmento parcial en line_buf
                                    while "\n" in line_buf:
                                        complete, line_buf = line_buf.split("\n", 1)
                                        _flush_line(complete)
                                    # line_buf puede tener el inicio de la línea siguiente —
                                    # NO lo escribimos directamente para evitar fragmentación
                                else:
                                    while "\n" in line_buf:
                                        complete, line_buf = line_buf.split("\n", 1)
                                        _early_gb_lines += 1
                                        if check_garbage and _is_garbage_early(complete):
                                            raise RuntimeError("__GARBAGE__")
                                        if _early_gb_lines >= 4:
                                            _early_gb_checked = True
                                        _flush_line(complete)
                                        if _early_gb_checked:
                                            # line_buf tiene el inicio de la línea siguiente —
                                            # dejarlo para que el else-branch lo complete correctamente
                                            break
                            else:
                                # Post-early-check: bufferear por líneas + rolling garbage check
                                line_buf += token
                                _roll_buf += token
                                _roll_tok += 1
                                if len(_roll_buf) > 60:
                                    _roll_buf = _roll_buf[-60:]
                                # Rolling garbage check cada 10 tokens (≈1s a 9 tok/s)
                                # Salteamos dentro de bloques de código: shell/HPL scripts son válidos
                                if check_garbage and _roll_tok % 10 == 0 and not in_code and _is_garbage_early(_roll_buf):
                                    raise RuntimeError(
                                        "__GARBAGE_SCREEN__" if _screen_lines_after_early > 0
                                        else "__GARBAGE__"
                                    )
                                # Dentro de código: detectar char repetido 25+ veces (alucinación de hash)
                                if check_garbage and in_code and _roll_tok % 10 == 0:
                                    import re as _re_ic
                                    # Excluir caracteres de separador decorativo (# ====, # ----,
                                    # # ****, etc. — patrón real y común en comentarios de shell/
                                    # Python, no es alucinación de hash). Bug real 30/8: /audit con
                                    # GLM disparaba __GARBAGE_SCREEN__ en vivo por esto.
                                    if _re_ic.search(r'([^=\-#_*~^.• \t])\1{24,}', _roll_buf):
                                        raise RuntimeError(
                                            "__GARBAGE_SCREEN__" if _screen_lines_after_early > 0
                                            else "__GARBAGE__"
                                        )
                                # Flush líneas completas (respeta filtros headers/listas/código)
                                while "\n" in line_buf:
                                    complete, line_buf = line_buf.split("\n", 1)
                                    _flush_line(complete)
                                # Línea parcial muy larga (ej. 10k palabras sin newline): mostrar progreso
                                if not silent and len(line_buf) > 300:
                                    if _lv[0] is not None:
                                        _lv[1].append(line_buf)
                                        _lv[0].update(_lv[1])
                                    elif _console is not None:
                                        _console.print(line_buf, end="", markup=False, highlight=False)
                                    else:
                                        sys.stdout.write(line_buf)
                                        sys.stdout.flush()
                                    _screen_lines_after_early += 1
                                    line_buf = ""
                    except (json.JSONDecodeError, KeyError, IndexError):
                        pass
        if line_buf:  # vuelca lo que quedó (sin newline final) respetando filtros
            _flush_line(line_buf)
    except KeyboardInterrupt:
        user_aborted.set()
        stop.set()
    finally:
        stop.set()
        first_token.set()
        resp.close()
        esc_thread.join(timeout=0.3)
        if _prose_acc:   # flush prosa dentro del Live (transient) — evita double-print con post-render
            _emit(" ".join(_prose_acc) + "\n")
            _prose_acc.clear()
        if _lv[0] is not None:
            _lv[0].stop()
            _lv[0] = None

    if not silent:
        if user_aborted.is_set():
            # Bug real 5/9 (usuarios reportan "aprieto Ctrl-C y no sé si funcionó o
            # está roto"): Ctrl-C a mitad de una respuesta solo cancela ESA respuesta,
            # no cierra gonzabot — sin aviso explícito la gente no lo sabe. Mostrar
            # siempre algo, incluso si full_text está vacío (Ctrl-C apretado muy al
            # principio, antes de que llegue texto).
            print(_c(YEL, " [cancelado — Ctrl-C de nuevo en el prompt para salir]"))
        elif _console is None:
            print()  # newline after streaming (live mode no lo necesita)
    text = "".join(full_text)

    # Detectar garbage output: muchos chars repetidos o nulos
    def _is_garbage(t: str) -> bool:
        import re as _re_g
        n = len(t)
        if n < 20:
            return False
        if t.count("\\")  > n * 0.25: return True
        if t.count("0")   > n * 0.55: return True
        if t.count("\x00")> n * 0.05: return True
        if t.count("➤")   > n * 0.05: return True
        if t.count("❖")   > n * 0.05: return True
        # Detectar alucinación: líneas con un mismo carácter repetido 25+ veces seguidas
        # (el modelo a veces genera 0000... o ════... donde debería ir código real)
        if _re_g.search(r'([^=\-#_*~^.• \t])\1{25,}', t):
            return True
        unusual = sum(1 for c in t if
            '✀' <= c <= '➿' or
            '一' <= c <= '鿿' or
            '֐' <= c <= '׿' or
            '가' <= c <= '퟿' or
            c >= '\U0001F000')
        return unusual > n * 0.05

    # Chequeo final del rolling buffer: tokens que no llegaron a un múltiplo de 10
    if check_garbage and _roll_buf and _roll_tok % 10 != 0 and not in_code and _is_garbage_early(_roll_buf):
        raise RuntimeError("__GARBAGE_SCREEN__" if _screen_lines_after_early > 0 else "__GARBAGE__")

    if check_garbage and _is_garbage(text):
        raise RuntimeError("__GARBAGE_SCREEN__" if _screen_lines_after_early > 0 else "__GARBAGE__")

    # Estimar tokens y acumular en sesión (~4 chars/token)
    global _SESSION_TOKENS
    _SESSION_TOKENS += (chars_in + len(text)) // 4
    if _SB_ACTIVE:
        _sb_draw()
    _log_event("request", chars_in=chars_in, chars_out=len(text))

    # Bloque abierto sin cerrar (respuesta cortada): cerrarlo
    if _cur_lines:
        _rich_blocks.append((_cur_lang, list(_cur_lines), _cur_title))

    # Llenar _LAST_CODE_BLOCKS para /save N /diff N /edit N
    # Solo si esta respuesta trae bloques — si no, conservar los #REF anteriores
    _new_blocks: list = []
    if _rich_blocks:
        for _rb_lang, _rb_lines, _rb_title in _rich_blocks:
            _new_blocks.append((_rb_lang, _dedent_code_block("\n".join(_rb_lines)), _rb_title))
    else:
        # fallback sin rich: extraer de full_text via regex
        import re as _re_gb
        for _m in _re_gb.finditer(r"```(?:\w+)?\n(.*?)```", text, _re_gb.DOTALL):
            _new_blocks.append(("", _dedent_code_block(_m.group(1)), ""))

    # Postproceso determinístico: fixes sbatch/heredoc + lint LAMMPS
    _pp_warns: list[str] = []
    try:
        import re as _re_pp
        for _i, (_pl, _pb, _pt) in enumerate(_new_blocks):
            _fixed = _fix_sbatch(f"```{_pl}\n{_pb}\n```")
            _mfx = _re_pp.match(r"```\w*\n(.*)\n```\n?(.*)$", _fixed, _re_pp.DOTALL)
            if not _mfx:
                continue
            _body = _mfx.group(1)
            for _wl in (_mfx.group(2) or "").split("\n"):
                _wl = _wl.strip().lstrip("⚠").strip()
                if _wl:
                    _pp_warns.append(_wl)
            _new_blocks[_i] = (_pl, _body, _pt)
            if _i < len(_rich_blocks):
                _rich_blocks[_i] = (_rich_blocks[_i][0], _body.split("\n"),
                                    _rich_blocks[_i][2])
        if _new_blocks:
            _pp_warns += _lint_ntasks(_new_blocks)
        text = _fix_sbatch(text)
    except Exception:
        pass
    if _new_blocks:
        _LAST_CODE_BLOCKS = _new_blocks

    # Renderizar respuesta formateada: prose con rich.Markdown + código con rich.Syntax
    if _console is not None and not silent and _raw_buf:
        try:
            import re as _re_md
            from rich.syntax import Syntax as _Syn
            from rich.panel import Panel as _Pan
            from rich.markdown import Markdown as _MD
            _LANG_DISPLAY = {
                "bash": "bash", "sh": "bash", "shell": "bash",
                "python": "python", "py": "python",
                "fortran": "fortran", "f90": "fortran", "f95": "fortran",
                "cpp": "cpp", "c++": "cpp", "c": "c",
                "diff": "diff", "text": "text", "": "text",
            }
            raw_text = "".join(_raw_buf)
            parts = _re_md.split(r'(```[\s\S]*?```)', raw_text)
            code_idx = 0
            _n_blocks = len(_rich_blocks)
            _console.print()
            for _part in parts:
                if _part.startswith("```"):
                    if code_idx < len(_rich_blocks):
                        _rb_lang, _rb_lines, _rb_title = _rich_blocks[code_idx]
                        _ref_num  = code_idx + 1
                        _ref_lbl  = f"#REF{_ref_num}" if _n_blocks > 1 else "#REF"
                        if _RAW_MODE:
                            # Sin Panel: texto plano, nada de bordes que se seleccionen
                            # junto con el código al copiar/pegar (bug real 5/9).
                            _lbl_plain = f"{_ref_lbl} ({_rb_lang})" if _rb_lang else _ref_lbl
                            _console.print(f"[dim cyan]--- {_lbl_plain} ---[/dim cyan]")
                            _console.print("\n".join(_rb_lines), markup=False, highlight=False)
                            _console.print(f"[dim cyan]--- fin {_ref_lbl} ---[/dim cyan]")
                        else:
                            lexer = _LANG_DISPLAY.get(_rb_lang.lower(), _rb_lang or "text")
                            syn   = _Syn("\n".join(_rb_lines), lexer, theme="monokai",
                                         line_numbers=False, word_wrap=False)
                            _cp_hint  = f"[dim] ⎘ /copy {_ref_num} [/dim]" if _n_blocks > 1 else "[dim] ⎘ /copy [/dim]"
                            _lp       = f"[dim]{_rb_lang}[/dim] " if _rb_lang else ""
                            _console.print(_Pan(syn, title=f"{_lp}[bold cyan]{_ref_lbl}[/bold cyan]{_cp_hint}",
                                                border_style="cyan", padding=(0, 1)))
                        code_idx += 1
                else:
                    _ps = _part.strip()
                    if _ps:
                        _console.print(_MD(_ps))
            if _n_blocks > 1:
                _console.print()
                _ref_names = _saveall_names([(_l, "\n".join(_ls), _t)
                                             for _l, _ls, _t in _rich_blocks])
                for _bi, (_rb_lang, _rb_lines, _rb_title) in enumerate(_rich_blocks):
                    _ref_lbl = f"#REF{_bi+1}"
                    _desc = _rb_title.strip() if _rb_title else (_rb_lang or "código")
                    _desc = _re_md.sub(r'\*+([^*]+)\*+', r'\1', _desc)
                    _desc = _re_md.sub(r'^[-*]\s+', '', _desc)
                    _fn = _ref_names[_bi] if _bi < len(_ref_names) else ""
                    _console.print(f"  [bold cyan]{_ref_lbl}[/bold cyan] "
                                   f"[yellow]{_fn}[/yellow] [dim]→ {_desc}[/dim]",
                                   markup=True)
                _console.print(f"  [dim]/saveall <dir> guarda todos con esos nombres[/dim]",
                               markup=True)
            _console.print()
        except Exception:
            pass

    # Warnings del lint LAMMPS — visibles después de los bloques
    if _pp_warns and not silent:
        for _w in dict.fromkeys(_pp_warns):
            if _console is not None:
                _console.print(f" ⚠ {_w}", style="yellow", markup=False)
            else:
                print(_c(YEL, f" ⚠ {_w}"))
        if _console is not None:
            _console.print()
        else:
            print()

    return text


# ── REPL ──────────────────────────────────────────────────────────────────────
HELP_TEXT = f"""{_c(BOLD, "gonzabot")} — Asistente IA local del cluster HPC UNMDP

Comandos:
  /load <path|url|glob|dir>  Carga archivos como contexto de esta sesión
  /save [N] <archivo>        Guarda código en un archivo (N obligatorio si hay múltiples bloques #REF)
  /saveall [dir]             Guarda TODOS los bloques #REF con sus nombres detectados (default: dir actual)
  /copy [N]                  Copia bloque #REFN al portapapeles (OSC 52, sin rayas de borde)
  /diff [N] <archivo>        Muestra diff (con N: usa bloque #REFN; sin N: el bot genera el diff)
  /edit [N] <archivo>        Edita el archivo (con N: aplica bloque #REFN; sin N: el bot genera el edit)
                             → /edit y /diff sin N llaman al modelo con el archivo real como contexto
                             → /edit siempre hace backup automático (.bak)

  Cuando la respuesta tiene varios bloques aparecen etiquetados #REF1, #REF2...
  Ejemplo:  /save 2 job.sbatch   /diff job.sbatch   /edit 1 main.c
  <comando>                  Los comandos del sistema se ejecutan directo (squeue, ls, rm, python3, ...)
  [pegar sbatch]             Pegá el script → el bot detecta #SBATCH → s = someter al cluster
  /audit                     Analiza todos los jobs en ejecución y sugiere mejoras
  /queue [usuario]           Muestra la cola del usuario y analiza con el bot
  /diagnose <job_id>         Carga los logs del job y pide al bot que diagnostique
  /branch <archivo>          Genera 3 variantes de optimización y las somete al cluster
  /branch check <job_id>     Lee resultados del array y declara qué variante es mejor
  /compact                   Resume la conversación actual y libera contexto
  /clear                     Limpia los mensajes de la sesión (el historial queda en DB)
  /history [N]               Muestra las últimas N conversaciones (default 5)
  /history <keyword ...>     Busca en el historial e inyecta resultados como contexto
  /history <session_id>      Carga una sesión completa como contexto (formato: YYYYMMDD-HHMMSS)
  /model                     Muestra el modelo y endpoint actual
  /raw                       Activa/desactiva bloques de código sin recuadro (más
                             fácil de copiar en terminales básicas como la de Windows)
  /help                      Muestra esta ayuda
  Ctrl-D / /exit             Salir

Flujo /branch — optimización automatizada en 3 pasos:
  1. gonzabot /branch mi_script.py
       El bot analiza el código y genera 3 variantes:
         A) corrección de bug científico
         B) optimización de rendimiento
         C) segunda optimización alternativa
       Cada variante se aplica como diff y se verifica sintaxis/compilación.
       Las que pasan se someten como array job al cluster.

  2. Esperás a que terminen los jobs (squeue para ver el estado).
       Los resultados quedan en branches/output_branch_N/ dentro del mismo directorio.

  3. gonzabot /branch check <job_id>
       El bot lee los tiempos de pared de cada variante, los compara con el
       baseline y te dice cuál es la mejor y por qué.

  Si alguna variante no aplica (diff incorrecto), el bot lo reporta y sigue
  con las demás. Solo se someten las que compilan correctamente.

Endpoint: {VLLM_BASE}
Modelo:   {MODEL}
"""


def repl(new_session: bool = False):
    con = init_db()
    session_id = new_session_id()

    _init_context()
    system_msg = {"role": "system", "content": load_system_prompt()}

    # Load previous messages into context (unless --new)
    if new_session:
        context_msgs: list[dict] = []
    else:
        context_msgs = load_recent_messages(con, MAX_CTX_MSGS)

    extra_context: list[str] = []  # from /load, injected as user context messages
    last_reply: str = ""           # for /save
    _repl_turn: int = 0           # contador de turnos para advertencia de sesión larga

    _log_event("session_start", new=new_session)
    if _check_online():
        _warmup()
    if sys.stdout.isatty():
        sys.stdout.write("\x1b[2J\x1b[H")
        sys.stdout.flush()
    _sb_setup()
    if _console:
        _console.print()
    else:
        print()
    print_welcome(session_id, len(context_msgs), new_session)

    while True:
        try:
            if _console and _SB_ACTIVE:
                _console.print(_make_status())
            user_input = _raw_input(_c(GRN + BOLD, "❯ "))
        except (EOFError, KeyboardInterrupt):
            print()
            break

        if not user_input:
            continue

        # ── /paste: multi-line input (before command block so it falls through) ──
        if user_input == "/paste":
            print(_c(DIM, "  Pegá tu código o error. Terminá con . solo en una línea (o Ctrl-D):"))
            lines = []
            while True:
                try:
                    line = input("")
                except EOFError:
                    break
                if line == ".":
                    break
                lines.append(line)
            if not lines:
                continue
            user_input = "\n".join(lines)
            # Falls through to regular message processing

        # ── /load embebido a mitad de mensaje: sin esto, "/load ~/x" que no
        # arranca el mensaje queda como texto suelto y el modelo alucina el
        # contenido del archivo en vez de fallar o pedir que se repita ──
        if not user_input.startswith("/load"):
            _embedded_load = re.search(r'/load\s+(\S+)', user_input)
            if _embedded_load:
                _load_arg = _embedded_load.group(1)
                try:
                    _content = load_resource(_load_arg)
                    _label = _load_arg.split("/")[-1][:60] or _load_arg[:60]
                    _MAX_LOAD = 25_000
                    if len(_content) > _MAX_LOAD:
                        _content = _content[:_MAX_LOAD] + f"\n\n[... omitido, {len(_content):,} chars totales]"
                    extra_context.append(f"[Contexto cargado: {_label}]\n{_content}")
                    user_input = (user_input[:_embedded_load.start()] + user_input[_embedded_load.end():]).strip()
                    print(_c(GRN, f"Cargado: {_label}"))
                    if not user_input:
                        continue
                except RuntimeError as e:
                    print(_c(RED, f"Error cargando {_load_arg}: {e}"))
                    print(_c(YEL, "Repetí el pedido — no tengo el archivo cargado."))
                    continue

        # ── Commands ──────────────────────────────────────────────────────────
        _KNOWN_CMDS = {
            "/exit", "/quit", "/q", "/help", "/queue", "/save", "/saveall", "/copy",
            "/edit", "/diff", "/audit", "/diagnose", "/history", "/compact",
            "/clear", "/paste", "/load", "/branch", "/model", "/raw",
        }
        _first_slash_word = user_input.split(None, 1)[0].lower() if user_input.startswith("/") else ""
        if _first_slash_word in _KNOWN_CMDS:
            parts = user_input.split(None, 1)
            cmd   = parts[0].lower()
            arg   = parts[1] if len(parts) > 1 else ""

            _log_event("command", cmd=cmd)

            if cmd in ("/exit", "/quit", "/q"):
                break

            elif cmd == "/help":
                print(HELP_TEXT)

            elif cmd == "/raw":
                # Bug real 5/9 (reporte de usuario real): en terminales
                # básicas (ej. la de Windows por default) seleccionar con el mouse para
                # copiar agarra también los bordes del recuadro de rich.Panel — molesto,
                # hay que borrarlos a mano después. /raw saca el recuadro de los bloques
                # de código (texto plano, fácil de seleccionar) sin tocar /saveall.
                global _RAW_MODE
                _RAW_MODE = not _RAW_MODE
                if _RAW_MODE:
                    print(_c(GRN, "Modo raw activado — los bloques de código salen sin "
                                  "recuadro, más fácil de copiar en terminales básicas."))
                else:
                    print(_c(GRN, "Modo raw desactivado — vuelven los recuadros con "
                                  "resaltado de sintaxis."))

            elif cmd == "/model":
                print(f"  Endpoint: {VLLM_BASE}")
                print(f"  Modelo:   {MODEL}")
                print(f"  Ctx dir:  {CONTEXT_DIR}")
                for _seg, _ in _SEGMENTS:
                    _dev = CONTEXT_DIR / f"{_seg}-dev.txt"
                    _pro = CONTEXT_DIR / f"{_seg}.txt"
                    if _dev.exists():
                        print(f"  {_seg:18s}  {_dev.name}  ({len(_dev.read_text(encoding='utf-8', errors='replace')):,} chars)")
                    elif _pro.exists():
                        print(f"  {_seg:18s}  {_pro.name}  ({len(_pro.read_text(encoding='utf-8', errors='replace')):,} chars)")
                    else:
                        print(f"  {_seg:18s}  (no encontrado)")

            elif cmd == "/compact":
                if len(context_msgs) < 4:
                    print(_c(YEL, "Poco historial para compactar."))
                else:
                    print(_c(DIM, "Resumiendo conversación..."))
                    compact_prompt = (
                        "Hacé un resumen técnico conciso de esta conversación: "
                        "qué problemas se plantearon, qué soluciones se aplicaron, "
                        "qué archivos o comandos importantes surgieron, y cuál es el estado actual. "
                        "Máximo 300 palabras. Solo los hechos útiles para continuar trabajando."
                    )
                    # Limitar a últimos 16 mensajes para no saturar el contexto del modelo
                    _compact_ctx = context_msgs[-16:] if len(context_msgs) > 16 else context_msgs
                    compact_msgs = [system_msg] + _compact_ctx + [{"role": "user", "content": compact_prompt}]
                    try:
                        summary = stream_response(compact_msgs, max_tokens=600, silent=True)
                        context_msgs = [
                            {"role": "user",      "content": f"[Resumen de la sesión anterior]\n{summary}"},
                            {"role": "assistant", "content": "Entendido, continúo desde ese punto."}
                        ]
                        print()
                        print(_c(CYAN, "▶ ") + summary.strip())
                        print()
                        print(_c(GRN, f"Contexto compactado ({len(summary)} chars). Mensajes reducidos a 2."))
                    except RuntimeError as e:
                        if "__GARBAGE" in str(e):
                            context_msgs = []
                            print(_c(YEL, "Contexto demasiado largo para resumir — historial limpiado. Podés continuar."))
                        else:
                            print(_c(RED, f"Error: {e}"))

            elif cmd == "/clear":
                context_msgs = []
                extra_context = []
                print(_c(GRN, "Sesión limpiada."))

            elif cmd == "/history":
                if arg and not arg.isdigit():
                    search_history(con, arg, extra_context)
                else:
                    n = int(arg) if arg.isdigit() else 5
                    show_history(con, n)

            elif cmd == "/save":
                if not arg:
                    _ref_hint = f"  Ejemplo: /save 1 script.sh  /save 2 main.c" if _LAST_CODE_BLOCKS else ""
                    print(_c(YEL, f"Uso: /save [N] <archivo>{_ref_hint}"))
                    continue
                if not last_reply and not _LAST_CODE_BLOCKS:
                    print(_c(YEL, "No hay respuesta para guardar todavía."))
                    continue
                # Detectar /save N archivo  vs  /save archivo
                _sv_parts = arg.split(None, 1)
                _sv_ref = None
                _sv_file = arg
                if _sv_parts and _sv_parts[0].isdigit():
                    _sv_ref = int(_sv_parts[0])
                    _sv_file = _sv_parts[1] if len(_sv_parts) > 1 else ""
                if not _sv_file:
                    print(_c(YEL, "Falta el nombre del archivo."))
                    continue
                if _sv_ref is None and len(_LAST_CODE_BLOCKS) > 1:
                    _refs = "  ".join(f"#REF{i+1}" for i in range(len(_LAST_CODE_BLOCKS)))
                    print(_c(YEL, f"Hay {len(_LAST_CODE_BLOCKS)} bloques ({_refs}). Especificá cuál: /save N <archivo>"))
                    continue
                if _sv_ref is not None:
                    if not _LAST_CODE_BLOCKS:
                        print(_c(YEL, "No hay bloques #REF disponibles."))
                        continue
                    if _sv_ref < 1 or _sv_ref > len(_LAST_CODE_BLOCKS):
                        print(_c(YEL, f"#REF{_sv_ref} no existe — hay {len(_LAST_CODE_BLOCKS)} bloque(s)."))
                        continue
                    content_to_save = _LAST_CODE_BLOCKS[_sv_ref - 1][1]
                else:
                    content_to_save = _LAST_CODE_BLOCKS[0][1] if _LAST_CODE_BLOCKS else last_reply
                try:
                    dest = Path(_sv_file).expanduser()
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    if dest.exists():
                        print(_c(YEL, f"El archivo ya existe: {dest}"))
                        print(_c(YEL, f"Se va a hacer un backup en {dest}.bak antes de sobreescribir."))
                        _sv_lbl = f"#REF{_sv_ref}" if _sv_ref else "el bloque"
                        if not _yn_line(_c(BOLD, f"¿Sobreescribir con {_sv_lbl} ({len(content_to_save)} chars)? (s + Enter): ")):
                            print(_c(DIM, "Cancelado. El archivo original no fue modificado."))
                            continue
                        import shutil as _shutil
                        _shutil.copy2(dest, str(dest) + ".bak")
                        print(_c(DIM, f"Backup guardado en {dest}.bak"))
                    dest.write_text(content_to_save, encoding="utf-8")
                    _ref_tag = f"#REF{_sv_ref} " if _sv_ref else ""
                    print(_c(GRN, f"Guardado {_ref_tag}en {dest}  ({len(content_to_save)} chars)"))
                except OSError as e:
                    print(_c(RED, f"Error al guardar: {e}"))

            elif cmd == "/saveall":
                if not _LAST_CODE_BLOCKS:
                    print(_c(YEL, "No hay bloques #REF disponibles."))
                    continue
                _sa_dir = Path(arg.strip() if arg.strip() else ".").expanduser()
                try:
                    _sa_dir.mkdir(parents=True, exist_ok=True)
                except OSError as e:
                    print(_c(RED, f"No pude crear el directorio: {e}"))
                    continue
                _sa_names = _saveall_names(_LAST_CODE_BLOCKS)
                _sa_exist = [n for n in _sa_names if (_sa_dir / n).exists()]
                print(_c(BOLD, f"Guardando {len(_sa_names)} bloque(s) en {_sa_dir}/:"))
                for _i, _n in enumerate(_sa_names):
                    _mark = "  (sobreescribe)" if _n in _sa_exist else ""
                    print(f"  #REF{_i+1} → {_n}{_mark}")
                if _sa_exist and not _yn_line(
                        _c(BOLD, f"{len(_sa_exist)} archivo(s) ya existen. ¿Sobreescribir? (s + Enter): ")):
                    print(_c(DIM, "Cancelado."))
                    continue
                for _i, _n in enumerate(_sa_names):
                    _dest = _sa_dir / _n
                    if _dest.exists():
                        import shutil as _sh_sa
                        _sh_sa.copy2(_dest, str(_dest) + ".bak")
                    _dest.write_text(_LAST_CODE_BLOCKS[_i][1], encoding="utf-8")
                print(_c(GRN, f"Guardados {len(_sa_names)} archivo(s) en {_sa_dir}/"))

            elif cmd == "/copy":
                if not last_reply and not _LAST_CODE_BLOCKS:
                    print(_c(YEL, "No hay bloques #REF disponibles."))
                    continue
                _cp_ref = int(arg.strip()) if arg.strip().isdigit() else 1
                if _LAST_CODE_BLOCKS:
                    if _cp_ref < 1 or _cp_ref > len(_LAST_CODE_BLOCKS):
                        print(_c(YEL, f"#REF{_cp_ref} no existe — hay {len(_LAST_CODE_BLOCKS)} bloque(s)."))
                        continue
                    _cp_content = _LAST_CODE_BLOCKS[_cp_ref - 1][1]
                else:
                    import re as _re
                    _cp_blocks = _re.findall(r"```(?:\w+)?\n(.*?)```", last_reply, _re.DOTALL)
                    _cp_content = _cp_blocks[0] if _cp_blocks else last_reply
                import base64 as _b64
                _cp_b64 = _b64.b64encode(_cp_content.encode()).decode()
                if os.environ.get("TMUX"):
                    sys.stdout.write(f"\x1bPtmux;\x1b\x1b]52;c;{_cp_b64}\x07\x1b\\")
                else:
                    sys.stdout.write(f"\x1b]52;c;{_cp_b64}\x07")
                sys.stdout.flush()
                _ref_tag = f"#REF{_cp_ref} " if _LAST_CODE_BLOCKS else ""
                print(_c(GRN, f"⎘ {_ref_tag}copiado al portapapeles  ({len(_cp_content)} chars)"))

            elif cmd == "/diff":
                if not arg:
                    print(_c(YEL, "Uso: /diff [N] <archivo>"))
                    continue
                if not last_reply and not _LAST_CODE_BLOCKS:
                    print(_c(YEL, "No hay respuesta para comparar todavía."))
                    continue
                import re as _re, difflib as _diff
                _df_parts = arg.split(None, 1)
                _df_ref = None; _df_file = arg
                if _df_parts and _df_parts[0].isdigit():
                    _df_ref = int(_df_parts[0]); _df_file = _df_parts[1] if len(_df_parts) > 1 else ""
                if not _df_file:
                    print(_c(YEL, "Falta el nombre del archivo.")); continue
                if _df_ref is not None and _LAST_CODE_BLOCKS:
                    if _df_ref < 1 or _df_ref > len(_LAST_CODE_BLOCKS):
                        print(_c(YEL, f"#REF{_df_ref} no existe.")); continue
                    nuevo = _LAST_CODE_BLOCKS[_df_ref - 1][1]
                else:
                    blocks = _re.findall(r"```(?:\w+)?\n(.*?)```", last_reply, _re.DOTALL)
                    _raw_df = blocks[0] if blocks else last_reply
                    nuevo = "".join(
                        l for l in _raw_df.splitlines(keepends=True)
                        if not l.startswith("### ")
                    )
                dest = Path(_df_file).expanduser()
                if not dest.exists():
                    print(_c(YEL, f"Archivo no existe aún: {dest} (usá /save para crearlo)"))
                    continue
                original = dest.read_text(encoding="utf-8", errors="replace")
                delta = list(_diff.unified_diff(
                    original.splitlines(keepends=True),
                    nuevo.splitlines(keepends=True),
                    fromfile=f"original/{dest.name}",
                    tofile=f"gonzabot/{dest.name}",
                ))
                if not delta:
                    print(_c(GRN, "Sin diferencias — el archivo ya coincide con la sugerencia."))
                else:
                    for line in delta:
                        if line.startswith("+") and not line.startswith("+++"):
                            print(_c(GRN, line), end="")
                        elif line.startswith("-") and not line.startswith("---"):
                            print(_c(RED, line), end="")
                        else:
                            print(_c(DIM, line), end="")

            elif cmd == "/edit":
                if not arg:
                    print(_c(YEL, "Uso: /edit [N] <archivo>"))
                    continue
                if not last_reply and not _LAST_CODE_BLOCKS:
                    print(_c(YEL, "No hay respuesta para aplicar todavía."))
                    continue
                import re as _re, difflib as _diff, shutil as _shutil
                _ed_parts = arg.split(None, 1)
                _ed_ref = None; _ed_file = arg
                if _ed_parts and _ed_parts[0].isdigit():
                    _ed_ref = int(_ed_parts[0]); _ed_file = _ed_parts[1] if len(_ed_parts) > 1 else ""
                if not _ed_file:
                    print(_c(YEL, "Falta el nombre del archivo.")); continue
                if _ed_ref is not None and _LAST_CODE_BLOCKS:
                    if _ed_ref < 1 or _ed_ref > len(_LAST_CODE_BLOCKS):
                        print(_c(YEL, f"#REF{_ed_ref} no existe.")); continue
                    nuevo = _LAST_CODE_BLOCKS[_ed_ref - 1][1]
                else:
                    # Sin REF: usar el bloque de la última respuesta del bot.
                    # Stripeamos headers "### filename" que el modelo a veces agrega.
                    blocks = _re.findall(r"```(?:\w+)?\n(.*?)```", last_reply, _re.DOTALL)
                    if len(blocks) > 1:
                        # Bug real 28/8: con >1 bloque (ej. /diagnose con varios
                        # fragmentos de fix), tomar blocks[0] a ciegas asume que
                        # ES el archivo completo — si en realidad es un snippet
                        # chico, /edit lo escribe como si fuera todo el archivo
                        # y borra el resto. No adivinar: pedir el REF explícito.
                        print(_c(YEL,
                            f"La última respuesta tiene {len(blocks)} bloques de código — "
                            f"especificá cuál con /edit N {_ed_file} (ej. /edit 1 {_ed_file})."))
                        continue
                    _raw = blocks[0] if blocks else last_reply
                    nuevo = "".join(
                        l for l in _raw.splitlines(keepends=True)
                        if not l.startswith("### ")
                    )
                dest = Path(_ed_file).expanduser()
                dest.parent.mkdir(parents=True, exist_ok=True)
                if dest.exists():
                    original = dest.read_text(encoding="utf-8", errors="replace")
                    delta = list(_diff.unified_diff(
                        original.splitlines(keepends=True),
                        nuevo.splitlines(keepends=True),
                        fromfile=f"original/{dest.name}",
                        tofile=f"gonzabot/{dest.name}",
                    ))
                    if not delta:
