                def _fix_diff_counts(diff_text: str) -> str:
                    """Recalcula los contadores @@ -N,M +N,M @@ que el LLM suele calcular mal."""
                    lines = diff_text.splitlines(keepends=True)
                    out = []
                    i = 0
                    while i < len(lines):
                        m = _re.match(
                            r'^(@@ -)(\d+),\d+( \+)(\d+),\d+( @@.*)',
                            lines[i]
                        )
                        if m:
                            old_start, new_start = int(m.group(2)), int(m.group(4))
                            hunk = []
                            i += 1
                            while i < len(lines) and not _re.match(r'^(@@|---|\+\+\+)', lines[i]):
                                hunk.append(lines[i])
                                i += 1
                            old_count = sum(1 for l in hunk if l and l[0] not in ('+', '\\'))
                            new_count = sum(1 for l in hunk if l and l[0] not in ('-', '\\'))
                            out.append(
                                f'{m.group(1)}{old_start},{old_count}'
                                f'{m.group(3)}{new_start},{new_count}'
                                f'{m.group(5)}\n'
                            )
                            out.extend(hunk)
                        else:
                            out.append(lines[i])
                            i += 1
                    return ''.join(out)

                def _apply_diff_by_context(src_text: str, diff_text: str) -> str | None:
                    """Aplica un unified diff buscando contexto por contenido (ignora números @@ incorrectos)."""
                    src_lines = src_text.splitlines(keepends=True)
                    diff_lines = diff_text.splitlines()
                    i = 0
                    while i < len(diff_lines) and not diff_lines[i].startswith('@@'):
                        i += 1
                    result = list(src_lines)

                    def _lead(s): return len(s) - len(s.lstrip())

                    def _find_block(needle):
                        if not needle:
                            return -1
                        ns = [l.strip() for l in needle]
                        for j in range(len(result) - len(needle) + 1):
                            if [result[j+k].rstrip('\n').strip() for k in range(len(needle))] == ns:
                                return j
                        return -1

                    def _find_approx(needle, min_ratio=0.72):
                        """Coincidencia aproximada por difflib cuando el contexto exacto falla."""
                        import difflib as _dl
                        if not needle:
                            return -1
                        nlen = len(needle)
                        if len(result) < nlen:
                            return -1
                        ns = ' '.join(l.strip() for l in needle if l.strip())
                        if not ns:
                            return -1
                        best_j, best_r = -1, 0.0
                        for j in range(len(result) - nlen + 1):
                            fs = ' '.join(result[j+k].rstrip('\n').strip()
                                          for k in range(nlen) if result[j+k].strip())
                            ratio = _dl.SequenceMatcher(None, ns, fs, autojunk=False).ratio()
                            if ratio > best_r:
                                best_r, best_j = ratio, j
                        return best_j if best_r >= min_ratio else -1

                    def _reindent(lines, ref_diff_line, ref_file_line):
                        """Ajusta indentación de lines según el delta entre ref_diff_line y ref_file_line."""
                        if not ref_diff_line.strip():
                            return lines
                        delta = _lead(ref_file_line.rstrip('\n')) - _lead(ref_diff_line)
                        if delta == 0:
                            return lines
                        out = []
                        for l in lines:
                            if l.strip():
                                out.append(' ' * max(0, _lead(l) + delta) + l.lstrip())
                            else:
                                out.append(l)
                        return out

                    def _to_nl(lines):
                        return [l if l.endswith('\n') else l + '\n' for l in lines]

                    while i < len(diff_lines):
                        if not diff_lines[i].startswith('@@'):
                            i += 1
                            continue
                        i += 1
                        hunk = []
                        while i < len(diff_lines) and not diff_lines[i].startswith('@@'):
                            hunk.append(diff_lines[i])
                            i += 1
                        if not hunk:
                            continue
                        old_lines  = [l[1:] for l in hunk if l and l[0] in (' ', '-')]
                        new_lines  = [l[1:] for l in hunk if l and l[0] in (' ', '+')]
                        rem_only   = [l[1:] for l in hunk if l and l[0] == '-']
                        add_only   = [l[1:] for l in hunk if l and l[0] == '+']

                        def _ref_file_line(needle, found_idx):
                            """Primera línea no-vacía del bloque encontrado para usar como referencia de indentación."""
                            for k, l in enumerate(needle):
                                if l.strip():
                                    return result[found_idx + k].rstrip('\n')
                            return result[found_idx].rstrip('\n')

                        # Intento 1: bloque contiguo completo (contexto + eliminadas)
                        found = _find_block(old_lines)
                        if found != -1:
                            ref_d = next((l for l in old_lines if l.strip()), '')
                            adjusted = _reindent(new_lines, ref_d, _ref_file_line(old_lines, found))
                            result[found:found + len(old_lines)] = _to_nl(adjusted)
                            continue

                        # Intento 2: solo líneas eliminadas como bloque contiguo
                        if rem_only:
                            found = _find_block(rem_only)
                            if found != -1:
                                ref_d = next((l for l in rem_only if l.strip()), '')
                                adjusted = _reindent(add_only, ref_d, _ref_file_line(rem_only, found))
                                result[found:found + len(rem_only)] = _to_nl(adjusted)
                                continue

                        # Intento 3: reemplazar cada línea eliminada individualmente (1:1)
                        if rem_only and len(rem_only) == len(add_only):
                            temp = list(result)
                            ok = True
                            for rem, add in zip(rem_only, add_only):
                                fi = _find_block([rem])
                                if fi == -1:
                                    ok = False
                                    break
                                ref_d = rem if rem.strip() else add
                                ref_f = _ref_file_line([rem], fi)
                                adjusted = _reindent([add], ref_d, ref_f)
                                temp[fi] = adjusted[0] if adjusted[0].endswith('\n') else adjusted[0] + '\n'
                            if ok:
                                result = temp
                                continue

                        # Intento 4: coincidencia aproximada del bloque completo (difflib)
                        found = _find_approx(old_lines)
                        if found != -1:
                            ref_d = next((l for l in old_lines if l.strip()), '')
                            adjusted = _reindent(new_lines, ref_d, _ref_file_line(old_lines, found))
                            result[found:found + len(old_lines)] = _to_nl(adjusted)
                            continue

                        # Intento 5: coincidencia aproximada solo líneas eliminadas
                        if rem_only:
                            found = _find_approx(rem_only)
                            if found != -1:
                                ref_d = next((l for l in rem_only if l.strip()), '')
                                adjusted = _reindent(add_only, ref_d, _ref_file_line(rem_only, found))
                                result[found:found + len(rem_only)] = _to_nl(adjusted)
                                continue

                        return None  # hunk no encontrado en ningún modo
                    return ''.join(result)

                # ── configuración por lenguaje ────────────────────────────────
