                    print(_c(DIM, f"Analizando {len(branch_logs)} branch(es) del job {check_jid}..."))
                    messages_chk = [system_msg] + context_msgs + [{"role": "user", "content": check_prompt}]
                    save_message(con, session_id, "user", check_prompt)
                    try:
                        reply_chk = stream_response(messages_chk, check_garbage=False)
                    except RuntimeError as e:
