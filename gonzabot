                src_raw = src_path.read_text(encoding="utf-8", errors="replace")
                n_lines = src_raw.count('\n')
                use_diff = "diff_branch_prompt" in lang_cfg
                # Diff mode: primeros 3000 chars (declaraciones + loops críticos)
                # Completo mode: hasta 12000 chars
                src_code = src_raw[:3000] if use_diff else src_raw[:12000]
                branch_dir = src_path.parent / "branches"
                branch_dir.mkdir(parents=True, exist_ok=True)

                if use_diff:
                    branch_prompt = lang_cfg["diff_branch_prompt"].format(
                        code=src_code, filename=src_path.name, n_lines=n_lines
                    )
                    print(_c(DIM, f"Generando diffs para {src_path.name} ({n_lines} líneas, modo patch)..."))
                else:
