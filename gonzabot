def _dedent_code_block(text: str) -> str:
    """Saca la indentación común de un bloque de código extraído del reply.

    Bug real 29/8: cuando el modelo anida un bloque dentro de un ítem de
    lista numerada (markdown válido: "2. Crear el script:\\n   ```bash\\n
    codigo\\n   ```"), la fence y el cuerpo entero quedan indentados (ej. 3
    espacios). Sin dedent, /save y /saveall escriben el archivo con esa
    indentación en TODAS las líneas — incluido el shebang y cada #SBATCH,
    que Slurm ignora silenciosamente si no arrancan en columna 0 (rompe
    todos los recursos pedidos sin avisar: nodelist, mem, time, etc.)."""
    return textwrap.dedent(text)

_KNOWN_HASH_PREFIXES_CACHE = None
# Comandos propios de gonzabot que también aparecen como "/palabra" en core.txt —
# excluirlos explícitamente evita falsos positivos (bug real 30/8: la primera versión
# de este extractor tomaba CUALQUIER "/palabra" del texto, incluyendo "/branch",
# "/diagnose", nombres de paquete dentro de listas tipo "lammps/gromacs", etc.)
_KNOWN_SLASH_COMMANDS = {"diagnose", "branch", "load", "save", "saveall",
                         "edit", "diff", "help", "audit", "queue",
                         "compact", "history", "new", "model"}

def _known_hash_prefixes() -> set:
    """Hashes de spack documentados en context/*.txt (siempre escritos como '/xxxxxxx',
    token aislado — no pegado a otra palabra ni seguido de una extensión de archivo).
    Se usa para detectar el bug real 30/8: el modelo reproduce el hash bien (a veces
    incluso más largo/preciso que el documentado) pero se olvida la '/' inicial —
    sin ella spack interpreta el argumento como NOMBRE de paquete, no como hash, y falla."""
    global _KNOWN_HASH_PREFIXES_CACHE
    if _KNOWN_HASH_PREFIXES_CACHE is None:
        prefixes = set()
        for f in CONTEXT_DIR.glob("*.txt"):
            try:
                text = f.read_text(errors="ignore")
            except OSError:
                continue
            for m in re.finditer(
                    r'(?:(?<=^)|(?<=[\s(]))/([0-9a-z]{6,32})(?=[\s),]|$)', text, re.M):
                tok = m.group(1)
                if tok not in _KNOWN_SLASH_COMMANDS:
                    prefixes.add(tok)
        _KNOWN_HASH_PREFIXES_CACHE = prefixes
    return _KNOWN_HASH_PREFIXES_CACHE

def _fix_sbatch(text: str) -> str:
    """Corrige scripts multi-nodo que usan spack load → rutas hardcodeadas (PATRÓN B)."""
    import re as _re

    _SPACK_PATS = (
        "export SPACK_USER_CACHE_PATH",
        "mkdir -p $SPACK_USER_CACHE_PATH",
        "source /usr/share/spack/root/share/spack/setup-env.sh",
        "eval $(spack load --sh lammps",
        "eval $(spack load --sh LAMMPS",
    )
    # Comentarios de sección que quedan huérfanos tras eliminar líneas spack
    _ORPHAN_COMMENTS = ("# Configuración de Spack", "# Carga de entorno Spack",
                        "# Carga Spack", "# Setup Spack")

    def _fix_block(block: str) -> str:
        m = _re.search(r'--nodes[= ](\d+)', block)
        if not m or int(m.group(1)) <= 1:
            return block
        if "spack load" not in block and "which lmp" not in block:
            return block

        lines = block.split("\n")
        kept = []
        for ln in lines:
            if any(p.lower() in ln.lower() for p in _SPACK_PATS):
                continue
            if any(ln.strip().lower() == c.lower() for c in _ORPHAN_COMMENTS):
                continue
            # Corregir LAMMPS_BIN=$(which lmp)
            ln = _re.sub(r'LAMMPS_BIN\s*=\s*\$\(which\s+lmp\)', f'LAMMPS_BIN={_LAMMPS_BIN}', ln)
            ln = _re.sub(r'\$\(which\s+lmp\)', '${LAMMPS_BIN}', ln)
            # Corregir OMPI_DIR=$(spack location ...)
            ln = _re.sub(r'OMPI_DIR\s*=\s*\$\(spack location[^)]+\)', f'OMPI_DIR={_OMPI_DIR}', ln)
            kept.append(ln)

        block = "\n".join(kept)

        # Insertar LAMMPS_BIN y OMPI_DIR si no están
        insert = ""
        if "LAMMPS_BIN=" not in block:
            insert += f"LAMMPS_BIN={_LAMMPS_BIN}\n"
        if "OMPI_DIR=" not in block:
            insert += (f"OMPI_DIR={_OMPI_DIR}\n"
                       "export PATH=${OMPI_DIR}/bin:$PATH\n"
                       "export LD_LIBRARY_PATH=${OMPI_DIR}/lib:${LD_LIBRARY_PATH}\n")
        if insert:
            block = _re.sub(r'(mpirun\b)', insert + r'\1', block, count=1)

        # Reemplazar lmp suelto como binario SOLO en líneas mpirun/srun
        new_lines = []
        for ln in block.split("\n"):
            if ("mpirun" in ln or "srun" in ln) and "LAMMPS_BIN" not in ln:
                ln = _re.sub(r'(?<![./\w])lmp(?=\s)', '${LAMMPS_BIN}', ln)
            new_lines.append(ln)
        return "\n".join(new_lines)

    def _fix_workdir(block: str) -> str:
        """Inyecta WORKDIR si falta o apunta al filesystem incorrecto para la partición."""
        # Script que referencia un archivo del usuario por RUTA RELATIVA (sin / ni $ al
        # inicio) — "source archivo.sh" O "-in archivo.lmp" (LAMMPS) — depende de quedarse
        # en el directorio de submit. Insertar cd $WORKDIR antes rompe esa referencia (el
        # archivo no existe en el WORKDIR nuevo y vacío). Bug real 28/8, dos casos: (1)
        # "source config.sh" en un script con 114 jobs reales corriendo; (2) "lmp -in
        # archivo.lmp" con el archivo real que el usuario cargó con /load — mismo patrón,
        # comando distinto. No tocar el directorio en ninguno de los dos casos.
        if _re.search(r'^\s*(?:source|\.)\s+(?!["\']?[/$])\S', block, _re.M):
            return block
        # El nombre puede tener una variable a mitad (ej. "-in script_k${k}.lmp", caso real
        # usuario4 29/8: un loop genera N archivos .lmp con el valor de un parámetro en el
        # nombre) — [\w${}.-]+ cubre eso además del nombre literal simple.
        if _re.search(r'-in\s+(?!["\']?[/$])[\w${}.-]+\.(?:lmp|lammps|in)\b', block):
            return block
        pm = _re.search(r'--partition[= ](gpu|cpu|scavenger)', block)
        if not pm:
            return block
        part = pm.group(1)
        expected = '/mnt/gpu-data' if part == 'gpu' else '/mnt/cpu-data'

        wd = _re.search(r'WORKDIR\s*=\s*(\S+)', block)
        if wd and expected in wd.group(1):
            return block  # ya correcto

        job_name = _re.search(r'--job-name[= ](\S+)', block)
        name = job_name.group(1).rstrip(',') if job_name else 'job'
        new_wd = (f'\n# Directorio de trabajo\n'
                  f'WORKDIR={expected}/$USER/{name}_$SLURM_JOB_ID\n'
                  f'mkdir -p $WORKDIR && cd $WORKDIR\n')

        if wd:
            # Reemplazar WORKDIR existente con su mkdir/cd
            block = _re.sub(
                r'WORKDIR\s*=\s*\S+.*?\n(?:mkdir.*?\n)?(?:cd.*?\n)?',
                new_wd, block, count=1, flags=_re.DOTALL)
        else:
            # Insertar después del último #SBATCH
            lines = block.split('\n')
            last_sbatch = max((i for i, l in enumerate(lines) if l.startswith('#SBATCH')), default=-1)
            if last_sbatch >= 0:
                lines.insert(last_sbatch + 1, new_wd)
                block = '\n'.join(lines)
        return block

    def _fix_heredoc_quotes(block: str) -> str:
        """Quotea marcadores de heredoc sin comillas que escriben archivos de CÓDIGO.

        cat << EOF > file.in → cat <<'EOF' > file.in — evita que bash expanda
        ${...} dentro de inputs generados (LAMMPS, Python, LaTeX).
        Solo para extensiones de código; .sh/.conf/etc. pueden querer expansión
        intencional ($SLURM_JOB_ID en un script generado).

        EXCEPCIÓN (bug real 28/8, caso usuario4): si el CUERPO del heredoc referencia
        mayormente variables bash asignadas antes en el mismo bloque (ej. un loop
        que genera N archivos .lmp, uno por valor de parámetro), es un TEMPLATE
        real que necesita expansión — quotearlo deja literales "${N}" sin resolver
        en los N archivos generados. Ahí no se toca."""
        _CODE_EXT = r'\.(in|lmp|lammps|tex|py|jl|m|R|C|cpp|f90|f95|pwi|fdf|mdin)\b'

        assigned = set(_re.findall(r'^\s*([A-Za-z_]\w*)\s*=[^=]', block, _re.M))
        assigned |= set(_re.findall(r'\bfor\s+(\w+)\s+in\b', block))

        lines = block.split('\n')
        out: list[str] = []
        i, n = 0, len(lines)
        while i < n:
            line = lines[i]
            m = _re.search(r"(<<)\s*(\w+)(\s*>{1,2}\s*(\S+))?", line)
            if not m or not _re.search(_CODE_EXT, line):
                out.append(line); i += 1; continue
            marker = m.group(2)
            body_lines = []
            j = i + 1
            while j < n and lines[j].strip() != marker:
                body_lines.append(lines[j]); j += 1
            body = '\n'.join(body_lines)
            refs = set(_re.findall(r'\$\{?([A-Za-z_]\w*)\}?', body))
            if refs and len(refs & assigned) / len(refs) >= 0.5:
                out.append(line)  # template real: dejar sin comillas
            else:
                out.append(_re.sub(r"(<<)\s*(\w+)", lambda mm: f"{mm.group(1)}'{marker}'",
                                    line, count=1))
            out.extend(body_lines)
            out.append(lines[j] if j < n else marker)
            i = j + 1
        return '\n'.join(out)

    def _fix_dollar_escapes(block: str) -> str:
        """Saca backslashes espurios antes de $ FUERA de heredocs.

        Bug real detectado 28/8: el modelo a veces escribe \\$SLURM_ARRAY_TASK_ID,
        \\$(printf ...), \\${k}, etc. en el cuerpo bash normal de un sbatch (fuera
        de cualquier heredoc) — probablemente contagio del habito de escapar $
        para prosa matematica tipo LaTeX \\( k \\) cuando la misma respuesta mezcla
        explicacion con codigo. Eso rompe la sintaxis real de bash ("syntax error
        near unexpected token") o deja variables sin expandir. Dentro de un
        heredoc SIN comillas (<<EOF, no <<'EOF'), \\$ puede ser legitimo para
        proteger variables propias del lenguaje embebido (ej. \\${L} de LAMMPS) —
        ahi NO se toca."""
        lines = block.split('\n')
        out = []
        in_heredoc = False
        marker = None
        for ln in lines:
            if in_heredoc:
                if ln.strip() == marker:
                    in_heredoc = False
                    marker = None
                out.append(ln)
                continue
            m = _re.search(r"<<-?\s*(['\"]?)(\w+)\1", ln)
            if m:
                in_heredoc = True
                marker = m.group(2)
                out.append(ln)
                continue
            out.append(_re.sub(r'\\(\$)', r'\1', ln))
        return '\n'.join(out)

    def _lint_filesystem(block: str) -> list[str]:
        """Chequea contra el filesystem real (gonzabot corre en ql-front con acceso
        directo a /mnt, /apps, /usr, /data): 'source <path literal>' a un archivo
        que no existe, y variables tipo _DIR/_BIN usadas (${X}/bin/...) pero nunca
        asignadas en el mismo bloque. Ambos son alucinaciones típicas de software
        poco frecuente en el contexto (ej. paquete nuevo recién instalado)."""
        warns = []
        created = set(_re.findall(r'>\s*(\S+)\s*$', block, _re.M))
        created |= set(_re.findall(r'\bcp\s+\S+\s+(\S+)', block))
        for m in _re.finditer(r'^\s*(?:source|\.)\s+(/(?:mnt|apps|usr|data)/\S+?)(?:\s|$)',
                              block, _re.M):
            path = m.group(1)
            if path in created:
                continue
            if not os.path.exists(path):
                warns.append(f"'{path}' no existe en el filesystem — "
                             f"verificar la ruta antes de sourcearla")
        # No restringido a sufijo _DIR/_BIN: bug real 30/8 (SPACK/AOCC bare,
        # sin sufijo, usados en un sbatch de GSL sin nunca asignarlos).
        _STD_ENV_VARS = {"HOME", "USER", "PATH", "PWD", "OLDPWD", "TMPDIR",
                          "SHELL", "LANG", "LC_ALL", "TERM", "LOGNAME",
                          "HOSTNAME", "DISPLAY", "WORKDIR"}
        used = set(_re.findall(r'\$\{?(\w+)\}?/(?:bin|include|lib64?)\b', block))
        used |= set(_re.findall(r'\$\{?(\w+)\}?\s+(?:--no-locks\s+)?location\s+-i',
                                block))
        assigned = set(_re.findall(r'^\s*(\w+)\s*=', block, _re.M))
        used = {v for v in used
                if not v.startswith('SLURM_') and v not in _STD_ENV_VARS}
        for v in sorted(used - assigned):
            if v == "SPACK":
                warns.append("'SPACK' se usa pero nunca se define en el script — "
                             "falta SPACK=/apps/local/spack/spack-2026b/spack/bin/spack")
            else:
                warns.append(f"'{v}' se usa pero nunca se define en el script — "
                             f"falta {v}=$($SPACK --no-locks location -i /hash)")
        # Compilador invocado desde el bin/ de un paquete que NO es un toolchain
        # (bug real 30/8: GSL_DIR/bin/gcc — GSL es librería, no trae compilador).
        _COMPILER_BINS = {"gcc", "g++", "gfortran", "clang", "clang++", "cc",
                          "nvfortran", "nvc", "nvc++", "nvcc"}
        _COMPILER_DIR_PREFIXES = {"AOCC", "NVHPC", "GCC", "GCC13", "GCC14", "CUDA"}
        for m in _re.finditer(r'\$\{?(\w+_DIR)\}?/bin/([\w+]+)', block):
            dirvar, binname = m.group(1), m.group(2)
            if binname not in _COMPILER_BINS:
                continue
            prefix = dirvar[:-4]  # quitar sufijo _DIR
            if binname == "nvcc" and prefix == "CUDA":
                continue  # CUDA_DIR/bin/nvcc es el patrón correcto
            if prefix in _COMPILER_DIR_PREFIXES:
                continue
            warns.append(f"'{dirvar}/bin/{binname}' — {prefix} no es un paquete que "
                         f"provea compilador (es una librería) — usar el {binname} "
                         f"del sistema/spack normal, o AOCC_DIR/NVHPC_DIR si corresponde")
        # Bug real 30/8: pide GPU (--gres=gpu) pero el spec de spack pedido es ~cuda
        # (variante SIN CUDA) — la GPU asignada por Slurm queda sin usar.
        if _re.search(r'--gres=gpu', block) and _re.search(r'[\w@.]+~cuda\b', block):
            warns.append("pediste GPU (--gres=gpu) pero el spec de spack tiene ~cuda "
                         "(variante SIN soporte CUDA) — la GPU asignada queda sin uso, "
                         "usar +cuda o el hash +cuda correspondiente")
        # Bug real 30/8: 'location -i <hash>' sin la '/' inicial — el hash en sí puede
        # estar bien (incluso ser un prefijo más largo/preciso que el documentado), pero
        # sin '/' spack lo interpreta como NOMBRE de paquete y falla ("no existe el paquete").
        _hash_prefixes = _known_hash_prefixes()
        for m in _re.finditer(r'\blocation\s+-i\s+(\S+)', block):
            tok = m.group(1)
            if tok.startswith('/') or tok.startswith('$'):
                continue
            if any(tok.startswith(p) or p.startswith(tok) for p in _hash_prefixes):
                warns.append(f"'location -i {tok}' sin '/' — es un hash de spack, sin la "
                             f"barra spack lo interpreta como nombre de paquete y falla: "
                             f"usar '/{tok}'")
        # Bug real 30/8 (confirmado en un nodo de cómputo real): "spack env activate
        # .../rebuild-full" ESTRECHA la visibilidad de paquetes a los miembros de ESE
        # environment — un hash real y válido, pero de un paquete fuera del environment,
        # falla con "matches no installed packages" aunque nunca estuvo roto. Reproducido
        # con LAMMPS (/3xvrevx): sin env activate exit 0, con env activate falla.
        if _re.search(r'\bspack\s+env\s+activate\b', block):
            _hash_like = set(_re.findall(r'/([0-9a-z]{6,32})\b', block))
            if any(any(h.startswith(p) or p.startswith(h) for p in _hash_prefixes)
                   for h in _hash_like):
                warns.append("'spack env activate' junto con un hash real (/hash) en el "
                             "mismo script — bug real 30/8: env activate estrecha la "
                             "visibilidad de paquetes al environment, y un hash válido "
                             "fuera de él falla con 'matches no installed packages' — "
                             "sacar 'spack env activate' cuando se usa un hash directo")
        # Bug real 5/9 (gonzabot propuso esto en vivo): gzip comprime un archivo y
        # después se le saca el sufijo .gz con un mv/rename SIN descomprimir —
        # el archivo queda con contenido gzip pero el nombre/extensión original,
        # corrupto para cualquier lector que espere el formato sin comprimir
        # (ej. numpy.load en un .npz).
        if (_re.search(r'\bgzip\s+(?!-d\b|-dc\b)\S', block)
                and _re.search(r'%\.gz\}', block)
                and not _re.search(r'\bgunzip\b|\bgzip\s+-d', block)):
            warns.append("gzip comprime y después se saca el sufijo .gz con mv/rename "
                         "SIN descomprimir (falta gunzip/gzip -d) — el archivo queda "
                         "con contenido gzip pero extensión original, corrupto para "
                         "quien lo lea esperando el formato sin comprimir")
        # Bug real 5/9 (gonzabot afirmó esto en vivo, texto engañoso aunque el script en
        # sí no rompe nada): "gzip *.npz" deja archivos .npz.gz que NO se pueden abrir
        # directo con np.load — hace falta descomprimir antes (gunzip) o pasar un
        # gzip.GzipFile a np.load. Avisar SIEMPRE que se comprima un .npz/.npy con gzip,
        # sin exigir que el propio bloque haga algo mal (es un recordatorio, no un error).
        if (_re.search(r'\bgzip\s+(?!-d\b|-dc\b)\S', block)
                and _re.search(r'\.np[yz]\b', block)
                and not _re.search(r'\bgunzip\b|\bgzip\s+-d|GzipFile', block)):
            warns.append("gzip sobre .npz/.npy: el archivo resultante (.npz.gz) NO se "
                         "puede abrir directo con np.load — hay que descomprimir antes "
                         "(gunzip) o usar np.load(gzip.GzipFile('archivo.npz.gz')) para "
                         "leerlo comprimido sin un paso separado")
        # Bug real 5/9 (reporte de usuario real): "spack load
        # py-numpy py-scipy py-matplotlib" bare falla — py-numpy/py-scipy son
        # ambiguos a propósito (3 ecosistemas, "matches multiple packages") y
        # py-matplotlib tiene su propio env file documentado que YA incluye
        # numpy+scipy juntos. El modelo a veces genera esto igual (variabilidad),
        # así que hace falta atraparlo determinísticamente, no confiar en que
        # siempre elija bien.
        _bare_ambiguous = {"py-numpy", "py-scipy", "py-matplotlib", "py-pandas"}
        for m in _re.finditer(r'\bspack\s+load\s+(?:--sh\s+)?([\w\s.-]+)', block):
            _pkgs = set(m.group(1).split())
            _hit = _pkgs & _bare_ambiguous
            if _hit:
                warns.append(f"'spack load {' '.join(sorted(_hit))}' bare falla o es "
                             f"ambiguo (py-numpy/py-scipy dan 'matches multiple packages', "
                             f"3 ecosistemas reales) — usar "
                             f"'source /mnt/cpu-data/shared/ifimar-ai/envs/matplotlib.env' "
                             f"(ya incluye numpy+scipy+matplotlib) o el hash exacto de cada uno")
                break
        return warns

    def _lint_lammps(block: str) -> list[str]:
        """Detecta sintaxis LAMMPS alucinada que corre pero da resultados basura."""
        _THERMO_OK = {
            "step", "elapsed", "elaplong", "dt", "time", "cpu", "tpcpu", "spcpu",
            "cpuremain", "part", "timeremain", "atoms", "temp", "press", "pe",
            "ke", "etotal", "enthalpy", "evdwl", "ecoul", "epair", "ebond",
            "eangle", "edihed", "eimp", "emol", "elong", "etail", "vol",
            "density", "lx", "ly", "lz", "xlo", "xhi", "ylo", "yhi", "zlo",
            "zhi", "xy", "xz", "yz", "xlat", "ylat", "zlat", "bonds", "angles",
            "dihedrals", "impropers", "pxx", "pyy", "pzz", "pxy", "pxz", "pyz",
            "fmax", "fnorm", "nbuild", "ndanger", "cella", "cellb", "cellc",
            "cellalpha", "cellbeta", "cellgamma",
        }
        warns = []
        for ln in block.split('\n'):
            s = ln.strip()
            m = _re.match(r'thermo_style\s+custom\s+(.*)', s)
            if m:
                for tok in m.group(1).split():
                    if tok in _THERMO_OK or _re.match(r'^[cfv]_\w+(\[(\d+|\*)\])?$', tok):
                        continue
                    warns.append(f"'{tok}' no es keyword válido de thermo_style — "
                                 f"los computes se referencian como c_ID[n]")
            if _re.search(r'variable\s+\w+\s+equal\s+.*(?<![cfv]_)\bmsd\s*\[', s):
                warns.append("msd[n] no existe como variable — definir compute msd "
                             "y referenciar c_ID[n]")
            if _re.match(r'compute\s+\w+\s+\w+\s+msd\b.*\bcom\s+yes', s):
                warns.append("compute msd con 'com yes' resta el centro de masa — "
                             "NO sirve para medir difusión del CM (usar sin com yes)")
            if _re.search(r'\)/bin/', s) and '$(' not in s:
                warns.append("falta '$(' en la sustitución de comando — "
                             "$(...location -i /hash)/bin/...")
            mm = _re.match(r'module\s+(load|avail|spider|swap|purge|list|unload)\b\s*(\S*)', s, _re.I)
            if mm:
                extra = f" {mm.group(2)}" if mm.group(2) else ""
                warns.append(f"'module {mm.group(1)}{extra}' no existe en este cluster "
                             f"(sin Lmod) — usar spack: $SPACK --no-locks location -i /hash")
        # Computes definidos pero nunca referenciados (c_ID) → el dato no sale al log
        for cm in _re.finditer(r'^\s*compute\s+(\w+)\s+\w+\s+\w+', block, _re.M):
            cid = cm.group(1)
            if f"c_{cid}" not in block:
                warns.append(f"compute '{cid}' definido pero nunca referenciado — "
                             f"agregarlo a thermo_style o fix ave/time como c_{cid}[n]")
        if _re.search(r'^\s*create_atoms\s+\d+\s+random', block, _re.M):
            warns.append("create_atoms random genera átomos solapados → 'Lost atoms' — "
                         "usar lattice fcc + create_atoms N box")
        # Bug real 30/8: create_box sin create_atoms después → caja vacía, "velocity"/
        # "run" fallan con "Velocity command with no atoms existing" (o corren sobre 0
        # átomos sin avisar). read_data también puebla la caja, cuenta como válido.
        if (_re.search(r'^\s*create_box\s', block, _re.M)
                and not _re.search(r'^\s*create_atoms\s', block, _re.M)
                and not _re.search(r'^\s*read_data\s', block, _re.M)):
            warns.append("'create_box' sin 'create_atoms' después — la caja queda vacía, "
                         "velocity/run fallan (o corren sobre 0 átomos) — agregar "
                         "'create_atoms N box' o 'read_data <archivo>'")
        # thermo/thermo_style después del último run → nunca se ejecuta
        _blines = block.split('\n')
        _runs = [i for i, l in enumerate(_blines) if _re.match(r'\s*run\s+\d', l)]
        if _runs:
            for i in range(_runs[-1] + 1, len(_blines)):
                if _re.match(r'\s*thermo(_style|_modify)?\s', _blines[i]):
                    warns.append("thermo/thermo_style después del último run no tiene "
                                 "efecto — va ANTES del run")
                    break
        return warns

    def _lint_gromacs(block: str) -> list[str]:
        """Bug real 30/8: gmx_mpi mdrun invocado sin mpirun (build MPI real, CRÍTICO
        en md-sim.txt) y -deffnm que no matchea el -o que generó grompp (mdrun busca
        <deffnm>.tpr y no lo encuentra)."""
        warns = []
        for gm in _re.finditer(r'\bgmx(?:_mpi)?\s+grompp\b[^\n]*?-o\s+(\S+)', block):
            tpr_out = gm.group(1)
            base = tpr_out[:-4] if tpr_out.endswith('.tpr') else tpr_out
            for mm in _re.finditer(r'\bgmx(?:_mpi)?\s+mdrun\b([^\n]*)', block):
                sm = _re.search(r'-deffnm\s+(\S+)', mm.group(1))
                if sm and sm.group(1) != base:
                    warns.append(f"grompp genera '{tpr_out}' pero mdrun usa "
                                 f"-deffnm {sm.group(1)} (buscaría {sm.group(1)}.tpr) "
                                 f"— nombres no coinciden, mdrun no encuentra el archivo")
        if _re.search(r'\bgmx_mpi\s+mdrun\b', block) and not _re.search(r'\bmpirun\b', block):
            warns.append("'gmx_mpi mdrun' sin mpirun -np $SLURM_NTASKS antes — build MPI "
                         "real, sin mpirun no reparte ranks (NUNCA -ntmpi con este build)")
        return warns

    # module name → (hash spack, nombre variable). Ver hpc.txt para la fuente de verdad.
    _MODULE_ALIASES = {
        "octave":    ("okdqlkti", "OCTAVE_DIR"),
        "r":         ("u2wwo4jw", "R_DIR"),
        "julia":     ("xr2wc6tn", "JULIA_DIR"),
        "wannier90": ("ih77wus",  "WANN_DIR"),
        "elk":       ("3lkw46bw", "ELK_DIR"),
        "siesta":    ("hauosan",  "SIESTA_DIR"),
        "abinit":    ("hiss2mz6", "ABINIT_DIR"),
        "plumed":    ("4jmhzvb",  "PLUMED_DIR"),
    }
    _MODULE_ROOT_HASH = "llflfpm"
    _MODULE_PYTHON_PKGS = {"python", "python3", "anaconda", "anaconda3",
                           "miniconda", "miniconda3", "conda"}

    def _fix_module_load(block: str) -> str:
        """Reemplaza 'module load X' por el patrón spack correcto (paquetes simples).

        Este cluster NO tiene Lmod — 'module' no es un comando válido en los nodos.
        Solo se auto-arreglan paquetes de un único binario con hash ya validado en
        hpc.txt; los demás (LAMMPS, GROMACS, QE, CUDA, Python...) quedan para el
        lint, porque requieren MPI/entorno específico que no es seguro adivinar."""
        if not _re.search(r'^\s*module\s+\w+', block, _re.M | _re.I):
            return block
        has_spack = bool(_re.search(r'^\s*SPACK\s*=', block, _re.M))
        out = []
        for ln in block.split('\n'):
            m = _re.match(r'^(\s*)module\s+load\s+([\w\-./@]+)', ln, _re.I)
            if not m:
                out.append(ln)
                continue
            indent, raw = m.groups()
            pkg = _re.split(r'[/@]', raw)[0].lower()
            if pkg in _MODULE_PYTHON_PKGS:
                out.append(ln)  # Python tiene su propio patrón (matplotlib.env) — no auto-fix
                continue
            if pkg == "root":
                if not has_spack:
                    out.append(f"{indent}SPACK=/usr/share/spack/root/bin/spack")
                    has_spack = True
                out.append(f"{indent}ROOT_DIR=$($SPACK --no-locks location -i /{_MODULE_ROOT_HASH} 2>/dev/null)")
                out.append(f"{indent}source ${{ROOT_DIR}}/bin/thisroot.sh")
                continue
            alias = _MODULE_ALIASES.get(pkg)
            if alias:
                hash_, var = alias
                if not has_spack:
                    out.append(f"{indent}SPACK=/usr/share/spack/root/bin/spack")
                    has_spack = True
                out.append(f"{indent}{var}=$($SPACK --no-locks location -i /{hash_} 2>/dev/null)")
                out.append(f"{indent}export PATH=${{{var}}}/bin:$PATH")
                continue
            out.append(ln)  # sin alias conocido → lo atrapa el lint
        return '\n'.join(out)

    def _fix_latex_heredoc(block: str) -> str:
        """Fix \\\\cmd → \\cmd in LaTeX heredoc sections targeting .tex files."""
        lines = block.split('\n')
        result = []
        in_latex = False
        marker = None
        for ln in lines:
            if not in_latex:
                m = _re.match(r"cat\s+<<\s*['\"]?(\w+)['\"]?\s*>.*?\.tex", ln)
                if m:
                    in_latex = True
                    marker = m.group(1)
                result.append(ln)
            else:
                if ln.strip() == marker:
                    in_latex = False
                    marker = None
                    result.append(ln)
                else:
                    result.append(_re.sub(r'\\\\([a-zA-Z{([])', r'\\\1', ln))
        return '\n'.join(result)

    def _replace(m):
        fence, body = m.group(1), m.group(2)
        tail = ""
        is_bash = (body.lstrip().startswith('#!/bin/bash')
                   or body.lstrip().startswith('#SBATCH'))
        is_lmp = bool(_re.search(r'^\s*(units|pair_style|thermo_style|bond_style)\s',
                                 body, _re.M))
        if is_bash:
            body = _fix_block(body)
            body = _fix_workdir(body)
            body = _fix_heredoc_quotes(body)
            body = _fix_dollar_escapes(body)
            body = _fix_module_load(body)
            body = _fix_latex_heredoc(body)
        if is_bash or is_lmp:
            warns = _lint_lammps(body)
            if is_bash:
                warns += _lint_filesystem(body)
                warns += _lint_gromacs(body)
            if warns:
                tail = "\n" + "\n".join(f"⚠ {w}" for w in dict.fromkeys(warns))
        return f"{fence}\n{body}\n```{tail}"

    return _re.sub(r'(```\w*)\n(.*?)```', _replace, text, flags=_re.DOTALL)


def _lint_ntasks(blocks: "list[tuple[str, str, str]]") -> list[str]:
    """Cross-block: detecta --ntasks sobredimensionado para el sistema LAMMPS.

    El --ntasks vive en el bloque bash y el tamaño del sistema en el bloque
    lammps (a veces separados) — por eso esta regla no puede ir en _fix_sbatch."""
    import re as _re
    ntasks = None
    atoms = None
    for _l, body, _t in blocks:
        m = _re.search(r'--ntasks[= ](\d+)', body)
        if m:
            ntasks = max(ntasks or 0, int(m.group(1)))
        lm = _re.search(r'^\s*lattice\s+(fcc|bcc|sc)\s', body, _re.M)
        rm = _re.search(r'^\s*region\s+\w+\s+block\s+'
                        r'([-\d.eE+]+)\s+([-\d.eE+]+)\s+([-\d.eE+]+)\s+'
                        r'([-\d.eE+]+)\s+([-\d.eE+]+)\s+([-\d.eE+]+)', body, _re.M)
        if lm and rm and 'create_atoms' in body:
            per_cell = {"fcc": 4, "bcc": 2, "sc": 1}[lm.group(1)]
            try:
                x0, x1, y0, y1, z0, z1 = (float(g) for g in rm.groups())
                est = per_cell * (x1 - x0) * (y1 - y0) * (z1 - z0)
                if est > 0:
                    atoms = int(est)
            except ValueError:
                pass
        cm = _re.search(r'create_atoms\s+\d+\s+random\s+(\d+)', body)
        if cm:
            atoms = int(cm.group(1))
    if ntasks and atoms and atoms < 10000 and ntasks >= 64:
        return [f"--ntasks={ntasks} para ~{atoms} átomos está sobredimensionado — "
                f"con <10k átomos usar 8-32 tasks (el overhead MPI domina)"]
    return []


