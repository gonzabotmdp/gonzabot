def _html_to_text(html: str) -> str:
    """Strip HTML tags and collapse whitespace into readable plain text."""
    from html.parser import HTMLParser
    import re as _re_h
    class _P(HTMLParser):
        def __init__(self):
            super().__init__()
            self._skip = False
            self._parts: list[str] = []
        def handle_starttag(self, tag, attrs):
            if tag in ("script", "style", "nav", "footer", "head"):
                self._skip = True
            elif tag in ("p", "br", "li", "h1", "h2", "h3", "h4", "h5", "tr", "div"):
                self._parts.append("\n")
        def handle_endtag(self, tag):
            if tag in ("script", "style", "nav", "footer", "head"):
                self._skip = False
        def handle_data(self, data):
            if not self._skip:
                self._parts.append(data)
    p = _P()
    p.feed(html)
    text = "".join(p._parts)
    text = _re_h.sub(r'\n{3,}', '\n\n', text)   # colapsar líneas vacías
    text = _re_h.sub(r'[ \t]+', ' ', text)        # colapsar espacios
    return text.strip()


def load_resource(arg: str) -> str:
    """Load a file path or URL and return its text content."""
    arg = arg.strip()
    if "arxiv.org/pdf/" in arg:
        # El PDF es binario — la página abs tiene el abstract en HTML
        arg = arg.replace("/pdf/", "/abs/").removesuffix(".pdf")
    if arg.startswith("http://") or arg.startswith("https://"):
        try:
            req = Request(arg, headers={"User-Agent": "gonzabot/1.0"})
            with urlopen(req, timeout=15) as resp:
                raw = resp.read(512 * 1024)
                ctype = resp.headers.get_content_charset("utf-8")
            text = raw.decode(ctype, errors="replace")
            return _html_to_text(text) if "<html" in text[:500].lower() else text
        except Exception:
            # Fallback: curl (maneja HTTPS aunque urllib no tenga SSL)
            try:
                r = subprocess.run(
                    ["curl", "-sL", "--max-filesize", "524288",
                     "-A", "gonzabot/1.0", "--max-time", "15", arg],
                    capture_output=True, timeout=20
                )
                if r.returncode != 0:
                    raise RuntimeError(f"curl error: {r.stderr.decode(errors='replace').strip()}")
                html = r.stdout.decode("utf-8", errors="replace")
                return _html_to_text(html) if "<html" in html[:500].lower() else html
            except FileNotFoundError:
                raise RuntimeError("curl no disponible y urllib no tiene SSL")
            except subprocess.TimeoutExpired:
                raise RuntimeError("Timeout al descargar URL")
    else:
        import glob as _glob
        expanded = str(Path(arg).expanduser())
        # Glob o directorio
        if '*' in expanded or '?' in expanded:
            paths = sorted(_glob.glob(expanded))
            if not paths:
                raise RuntimeError(f"No hay archivos que coincidan con: {arg}")
        else:
            path = Path(expanded)
            if path.is_dir():
                paths = sorted(str(p) for p in path.iterdir() if p.is_file())
                if not paths:
                    raise RuntimeError(f"Directorio vacío: {path}")
            else:
                paths = [expanded]

        MAX_TOTAL = 512 * 1024
        parts = []
        total = 0
        for p in paths:
            try:
                content = Path(p).read_text(encoding="utf-8", errors="replace")
                if total + len(content) > MAX_TOTAL:
                    parts.append(f"[{Path(p).name}: omitido — límite 512KB alcanzado]")
                    break
                parts.append(f"### {Path(p).name}\n{content}")
                total += len(content)
            except OSError:
                parts.append(f"[{Path(p).name}: no se pudo leer]")
        return "\n\n".join(parts)


