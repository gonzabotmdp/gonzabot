                try:
                    content = load_resource(arg)
                    label = arg.split("/")[-1][:60] or arg[:60]
                    n_files = content.count("\n### ")  + (1 if content.startswith("### ") else 0)
                    _MAX_LOAD = 25_000
                    if len(content) > _MAX_LOAD:
                        _trunc_note = f"\n\n[... {len(content) - _MAX_LOAD:,} caracteres adicionales omitidos — el documento completo tiene {len(content):,} chars]"
                        content_stored = content[:_MAX_LOAD] + _trunc_note
                        if n_files > 1:
                            resumen = f"{n_files} archivos, {len(content):,} caracteres (truncado a {_MAX_LOAD:,})"
                        else:
                            resumen = f"{len(content):,} caracteres (truncado a {_MAX_LOAD:,})"
                    else:
                        content_stored = content
                        if n_files > 1:
                            resumen = f"{n_files} archivos, {len(content):,} caracteres"
                        else:
                            resumen = f"{len(content):,} caracteres"
                    extra_context.append(f"[Contexto cargado: {label}]\n{content_stored}")
                    print(_c(GRN, f"Cargado: {label} ({resumen})"))
                except RuntimeError as e:
                    print(_c(RED, f"Error: {e}"))

            continue

        # ── Auto-run: comandos HPC/sistema reconocidos se ejecutan directamente ──
        _AUTO_RUN_CMDS = {
            # Slurm
            "squeue", "sinfo", "sacct", "sstat", "scontrol", "sprio", "sshare",
            "sbatch", "scancel", "srun",
            # GPU / CUDA
            "nvidia-smi", "nvtop", "nvcc",
            # Disco y filesystem
            "df", "du", "ls", "stat", "file", "lsblk", "lsof",
            # Procesos y sistema
            "ps", "free", "uptime", "top", "vmstat", "iostat", "mpstat",
            "date", "cal", "uname", "arch",
            # Identidad y entorno
            "whoami", "hostname", "id", "pwd", "env", "printenv", "which", "type",
            # Texto y archivos (solo lectura)
            "cat", "head", "tail", "grep", "find", "wc",
            "sort", "uniq", "cut", "tr", "diff", "strings",
            "awk", "sed", "echo", "printf",
            # Archivos (escritura / mutación — piden confirmación si son destructivos)
            "rm", "mkdir", "cp", "mv", "touch", "ln", "chmod", "chown", "rmdir",
            # Red y conectividad
            "ping", "traceroute", "tracepath", "mtr", "host", "curl", "wget",
            "ip", "ss", "netstat", "nslookup", "dig", "nc",
            # Hardware
            "lscpu", "lsmem", "lspci", "lsusb", "numactl", "lstopo",
            # Software y módulos
            "module", "spack", "git",
            # Archivos comprimidos
            "tar", "zcat", "gzip", "gunzip", "unzip", "zip",
            # Scripts / compilación
            "python3", "python", "bash", "sh", "make", "cmake",
            "mpirun", "mpiexec", "gcc", "gfortran", "g++",
        }
        _DANGEROUS_CMDS = {"rm", "rmdir", "chmod", "chown", "mkfs", "dd"}
        _DANGEROUS_PATTERNS = ["-rf", "-fr", "-r ", "> /", "/*"]
        # Protección de inyección: bloquear metacaracteres peligrosos
        import re as _re_inj
        _INJECT      = _re_inj.compile(r'[;&`]|\$\(|\|\|')   # caracteres peligrosos (hard block)
        _INJECT_PIPE = _re_inj.compile(r'(?<!\|)\|(?!\|)')   # pipe simple (soft: pasa al LLM)
        _first_word = _INJECT.sub("", user_input.split()[0]).lstrip("$").lower() if user_input.split() else ""

        # Bloque multilinea donde TODAS las líneas son comandos ejecutables →
        # correr secuencialmente (máx 6) en lugar de mandar al LLM como texto.
        if "\n" in user_input and not _INJECT.search(user_input):
            _ml_lines = [l.strip() for l in user_input.splitlines() if l.strip()]
            _ml_cmds  = [l for l in _ml_lines if
                         l.split()[0].lstrip("$").lower() in _AUTO_RUN_CMDS] if _ml_lines else []
            if _ml_lines and len(_ml_cmds) == len(_ml_lines) and len(_ml_lines) <= 6:
                _combined_out = []
                for _cmd in _ml_lines:
                    print(_c(DIM, f"  $ {_cmd}"))
                    try:
                        _r = subprocess.run(_cmd, shell=True, capture_output=True,
                                            text=True, timeout=30)
                        _out = (_r.stdout + _r.stderr).strip() or "(sin output)"
                    except subprocess.TimeoutExpired:
                        _out = "(timeout 30s)"
                    except Exception as _ex:
                        _out = f"(error: {_ex})"
                    print(_c(DIM, _out))
                    print()
                    _combined_out.append(f"$ {_cmd}\n{_out}")
                _ml_prompt = (
                    f"El usuario ejecutó estos {len(_ml_lines)} comandos en secuencia:\n\n"
                    + "\n\n".join(_combined_out)
                    + "\n\nResumí en 2-4 oraciones lo más relevante. Sin repetir cada output."
                )
                _ml_sys  = {"role": "system", "content": _BASE_PROMPT}
                _ml_msgs = [_ml_sys] + context_msgs[-6:] + [{"role": "user", "content": _ml_prompt}]
                if _check_online():
                    try:
                        _ml_reply = stream_response(_ml_msgs, max_tokens=500, check_garbage=False)
                    except RuntimeError as _e:
                        _handle_runtime_error(_e)
                        continue
                    save_message(con, session_id, "user",      user_input[:500])
                    save_message(con, session_id, "assistant", _ml_reply)
                    context_msgs.append({"role": "user",      "content": _ml_prompt})
                    context_msgs.append({"role": "assistant",  "content": _ml_reply})
                    if len(context_msgs) > MAX_CTX_MSGS:
                        context_msgs = context_msgs[-MAX_CTX_MSGS:]
                    last_reply = _ml_reply
                continue

        if "\n" not in user_input and not _INJECT.search(user_input) and not _INJECT_PIPE.search(user_input) and _first_word in _AUTO_RUN_CMDS:
            _is_dangerous = _first_word in _DANGEROUS_CMDS or any(p in user_input for p in _DANGEROUS_PATTERNS)
            if _is_dangerous:
                if not _yn_raw(_c(YEL, f"  ⚠ Operación destructiva: `{user_input[:60]}` — ¿continuar? [s/N] ")):
                    print(_c(DIM, "Cancelado."))
                    continue
            print(_c(DIM + CYAN, f"  $ {user_input}"))
            try:
                _ar = subprocess.run(
                    user_input, shell=True, capture_output=True, text=True, timeout=30
                )
                _ar_out = (_ar.stdout + _ar.stderr).strip() or "(sin output)"
            except subprocess.TimeoutExpired:
                print(_c(RED, "Timeout (30s)."))
                continue
            except Exception as _e:
                print(_c(RED, f"Error: {_e}"))
                continue
            print(_ar_out)
            print()
            _ar_notes = []
            import re as _re_ar
            if _first_word == "df":
                for _line in _ar_out.splitlines():
                    _m = _re_ar.search(r'(\d+)%\s+(\S+)$', _line)
                    if _m:
                        _pct, _mnt = int(_m.group(1)), _m.group(2)
                        if _pct >= 85:
                            _parts = _line.split()
                            _avail = _parts[3] if len(_parts) >= 4 else "?"
                            _ar_notes.append(f"⚠ {_mnt} al {_pct}% usado — solo {_avail} libres")
            elif _first_word == "du":
                for _line in _ar_out.splitlines():
                    _m = _re_ar.match(r'^(\d+\.?\d*)(G|T)\s+(\S+)', _line)
                    if _m:
                        _sz, _unit, _path = float(_m.group(1)), _m.group(2), _m.group(3)
                        if _unit == "T" or (_unit == "G" and _sz >= 10):
                            _ar_notes.append(f"⚠ {_path}: {_m.group(1)}{_unit} — directorio grande")
            elif _first_word in ("sacct", "sstat") and "error" in _ar_out.lower():
                _ar_notes.append("NOTA: sacct/sstat requieren acceso a slurmdbd. En ql-front puede fallar; intentá desde ql-head.")
            elif _first_word in ("nvidia-smi", "nvtop") and ("not found" in _ar_out or "No such" in _ar_out or _ar_out == "(sin output)"):
                _ar_notes.append("NOTA: nvidia-smi/nvtop no está disponible en ql-front (nodo de login, sin GPU). Para ver GPUs: ssh gpu-01 nvidia-smi  o  srun -p gpu --gres=gpu:1 nvidia-smi")
            elif _first_word == "ping":
                if "unknown host" in _ar_out or "Name or service not known" in _ar_out or "cannot resolve" in _ar_out.lower():
                    _ar_notes.append("NOTA: host no encontrado — verificá el nombre o la conectividad DNS.")
                elif "-c" not in user_input and _ar.returncode == 124:
                    _ar_notes.append("NOTA: ping sin -c cortado por timeout (30s). Usá ping -c N para limitar.")
            elif _first_word in ("squeue", "sprio") and _ar_out == "(sin output)":
                _ar_notes.append(f"NOTA: sin output — no hay jobs en cola para el filtro pedido.")
            elif _first_word == "sshare":
                for _line in _ar_out.splitlines():
                    if _USERNAME in _line:
                        _parts = _line.split()
                        if len(_parts) >= 7:
                            try:
                                _eff = float(_parts[6])
                                _fs  = float(_parts[5]) if len(_parts) > 5 else None
                                if _eff > 0.1:
                                    _ar_notes.append(f"NOTA: {_USERNAME} EffectvUsage={_eff:.3f} — usando bastante del cluster")
                                elif _eff < 0.001:
                                    _ar_notes.append(f"NOTA: {_USERNAME} EffectvUsage={_eff:.3f} — uso muy bajo, buena prioridad para nuevos jobs")
                            except (ValueError, IndexError):
                                pass
            if _first_word == "sbatch":
                _m_jid = _re_ar.search(r'Submitted batch job (\d+)', _ar_out)
                if _m_jid:
                    _ar_notes.append(f"Job sometido exitosamente. ID: {_m_jid.group(1)}. Para monitorear: squeue -j {_m_jid.group(1)}")
                elif _ar.returncode != 0:
                    _ar_notes.append("NOTA: sbatch falló. Revisá el script y los parámetros (#SBATCH).")
            elif _first_word == "scancel":
                if _ar.returncode == 0 and not _ar_out.strip():
                    _ar_notes.append("Job(s) cancelado(s) correctamente.")
                elif _ar.returncode != 0:
                    _ar_notes.append("NOTA: scancel falló — verificá que el job existe y que sos el dueño.")
            _notes_str = ("\nNOTAS AUTOMÁTICAS:\n" + "\n".join(_ar_notes)) if _ar_notes else ""
            _ar_prompt = (
                f"El usuario ejecutó: `{user_input}`\n"
                f"Output real:\n```\n{_ar_out[:3000]}\n```"
                f"{_notes_str}\n"
                f"Analizá en 1-3 oraciones concisas. Sin repetir el output."
            )
            _ar_sys = {"role": "system", "content": _BASE_PROMPT}
            _ar_msgs = [_ar_sys] + context_msgs[-6:] + [{"role": "user", "content": _ar_prompt}]
            if not _check_online():
                # Output ya se mostró — no arrancar vLLM por un comando de sistema
                if _ar_notes:
                    for _n in _ar_notes:
                        print(_c(YEL, f"  {_n}"))
                    print()
                continue
            try:
                _ar_reply = stream_response(_ar_msgs, max_tokens=400, check_garbage=False)
            except RuntimeError as e:
                _handle_runtime_error(e)
                continue
            save_message(con, session_id, "user",      f"{user_input}\n[output: {_ar_out[:500]}]")
            save_message(con, session_id, "assistant", _ar_reply)
            context_msgs.append({"role": "user",      "content": _ar_prompt})
            context_msgs.append({"role": "assistant",  "content": _ar_reply})
            if len(context_msgs) > MAX_CTX_MSGS:
                context_msgs = context_msgs[-MAX_CTX_MSGS:]
            last_reply = _ar_reply
            continue

        # ── Regular message ───────────────────────────────────────────────────
        # Detectar comando con metacaracteres peligrosos (hard block) — advertir sin alucinar
        # Pipes simples (|) NO se bloquean aquí: pasan al LLM para análisis.
        if "\n" not in user_input and _first_word in _AUTO_RUN_CMDS and _INJECT.search(user_input):
            print(_c(YEL, f"  ⚠ Metacaracteres detectados — comando no ejecutado por seguridad."))
            print(_c(YEL, f"    Separá los comandos en entradas distintas para ejecutarlos."))
            print()
            continue

        # Anotaciones para texto pegado con output conocido (df, etc.)
        import re as _re_paste
        _paste_notes = []
        if "\n" in user_input and "Use%" in user_input:
            # Parece output de df pegado — parsear y anotar igual que auto-run
            for _line in user_input.splitlines():
                _m = _re_paste.search(r'(\d+)%\s+(\S+)$', _line)
                if _m:
                    _pct, _mnt = int(_m.group(1)), _m.group(2)
                    _parts = _line.split()
                    # AppImage o montaje en /tmp/.mount_* al 100% = normal
                    _is_appimage = (".AppImage" in _line or "/tmp/.mount_" in _mnt)
                    if _pct >= 85 and not _is_appimage:
                        _avail = _parts[3] if len(_parts) >= 5 else "?"
                        _paste_notes.append(f"⚠ {_mnt} al {_pct}% usado — solo {_avail} libres")
                    elif _pct >= 85 and _is_appimage:
                        _paste_notes.append(f"OK {_mnt} al 100% — montaje AppImage, normal")
        _user_content = user_input
        # Cuando hay salto de línea con una intro tipo "mirá esto:", el LLM a veces
        # ignora los datos que siguen. Prefijo mínimo para anclar que ya están presentes.
        # Solo se aplica si la 1ra línea termina en : o ? y el resto parece datos/output.
        if "\n" in user_input:
            _lines = user_input.split("\n")
            _first = _lines[0].rstrip()
            _rest  = "\n".join(_lines[1:]).strip()
            _looks_like_output = bool(_rest) and any(
                c in _rest for c in ("|", "+", "$", "%", "=", ":")
            )
            if _first.endswith(":") and _looks_like_output:
                _user_content = (
                    f"{_first}\n"
                    f"(texto pegado — ya está abajo, leé los valores reales y respondé en prosa)\n"
                    f"{_rest}"
                )
        if _paste_notes:
            _user_content += "\n\nNOTAS AUTOMÁTICAS (no repetir, solo mencioná anomalías reales):\n" + "\n".join(_paste_notes)

        # Auto-suggest /diagnose si hay job ID + palabras de error en el mensaje
        import re as _re_diag
        _job_ids = _re_diag.findall(r'\b([3-9]\d{3}|[1-9]\d{4,6})\b', user_input)
        _error_words = any(w in user_input.lower() for w in ("falló", "fallo", "failed", "error", "killed", "oom", "abort", "crashed", "no corre", "no anda"))
        if _job_ids and _error_words:
            _jid = _job_ids[-1]
            print(_c(DIM, f"  💡 Tip: /diagnose {_jid} — cargo los logs del job automáticamente"))

        # Build messages for this turn
        # Prepend any /load context as a synthetic user message (once per session)
        _recent_hist = "\n".join(m.get("content", "")[:2000]
                                 for m in context_msgs[-8:])
        _query_system_msg = {"role": "system",
                             "content": _system_prompt_for(_user_content, _recent_hist)}
        messages_to_send: list[dict] = [_query_system_msg]

        if extra_context:
            combined = "\n\n---\n\n".join(extra_context)
            messages_to_send.append({
                "role": "user",
                "content": f"Contexto adicional para esta sesión:\n\n{combined}"
            })
            messages_to_send.append({
                "role": "assistant",
                "content": "Entendido, tendré en cuenta ese contexto."
            })

        messages_to_send.extend(context_msgs)
        messages_to_send.append({"role": "user", "content": _user_content})

        save_message(con, session_id, "user", user_input)

        # Calcular max_tokens según la cantidad de palabras/páginas solicitadas
        import re as _re_wc
        _max_tok = 3000
        _wc = _re_wc.search(r'(\d[\d.]*)\s*(?:palabras?|words?)', user_input.lower())
        _pg = _re_wc.search(r'(\d[\d.]*)\s*(?:páginas?|pages?|hojas?)', user_input.lower())
        if _wc:
            _n = int(float(_wc.group(1).replace(',', '.')))
            _max_tok = min(16000, max(8000, int(_n * 1.45) + 400))
        elif _pg:
            _n = float(_pg.group(1).replace(',', '.'))
            _max_tok = min(16000, max(8000, int(_n * 700) + 400))

        if not _check_online():
            if not _auto_start_service():
                print(_c(RED, "\nEl servicio de IA no está disponible. Contactá a Gonzalo: garroyo@ifimar-conicet.gob.ar\n"))
                continue

        try:
            reply = stream_response(messages_to_send, max_tokens=_max_tok)
        except RuntimeError as e:
            err = str(e)
            if "__GARBAGE" in err:
                # Respuesta corrupta — limpiar historial y reintentar automáticamente
                if "__GARBAGE_SCREEN__" in err:
                    # El garbage llegó a pantalla → limpiar varias líneas hacia arriba
                    sys.stdout.write("\r\x1b[2K")
                    for _ in range(4):
                        sys.stdout.write("\x1b[1A\x1b[2K")
                    sys.stdout.flush()
                else:
                    sys.stdout.write("\r\x1b[2K")  # borrar solo la línea actual (▶ sin contenido)
                    sys.stdout.flush()
                print(_c(YEL, "↺ Contexto muy largo — limpiando historial y reintentando..."))
                context_msgs = []
                messages_to_send = [_query_system_msg]
                if extra_context:
                    _ec_combined = "\n\n---\n\n".join(extra_context)
                    messages_to_send.append({"role": "user", "content": f"Contexto adicional:\n\n{_ec_combined}"})
                    messages_to_send.append({"role": "assistant", "content": "Entendido."})
                messages_to_send.append({"role": "user", "content": _user_content})
                try:
                    reply = stream_response(messages_to_send, max_tokens=_max_tok)
                except RuntimeError as e2:
                    err2 = str(e2)
                    if "__GARBAGE" in err2:
                        # Segundo reintento sin garbage check — input podría tener
                        # tablas/output con muchos espacios que no son basura real
                        if "__GARBAGE_SCREEN__" in err2:
                            sys.stdout.write("\r\x1b[2K")
                            for _ in range(4):
                                sys.stdout.write("\x1b[1A\x1b[2K")
                            sys.stdout.flush()
                        else:
                            sys.stdout.write("\r\x1b[2K")
                            sys.stdout.flush()
                        try:
                            reply = stream_response(messages_to_send, max_tokens=_max_tok,
                                                    check_garbage=False)
                        except RuntimeError as e3:
                            print(_c(RED, f"Error: {e3}\n"))
                            continue
                    else:
                        sys.stdout.write("\r\x1b[2K")
                        sys.stdout.flush()
                        print(_c(RED, f"Error tras reintento: {err2}\n"))
                        continue
            elif "No se puede conectar" in err or "Connection refused" in err:
                if _auto_start_service():
                    try:
                        reply = stream_response(messages_to_send)
                    except RuntimeError as e2:
                        print(_c(RED, f"\nError: {e2}\n"))
                        continue
                else:
                    continue
            else:
                print(_c(RED, f"\nError: {err}\n"))
                continue

        import re as _re_gs
        if _re_gs.search(r'0{20,}|O{20,}', reply):
            print(_c(YEL, "⚠ Respuesta con contenido repetitivo — no guardada en historial."))
        else:
            save_message(con, session_id, "assistant", reply)
        last_reply = reply

        # Add to context window
        context_msgs.append({"role": "user",      "content": user_input})
        context_msgs.append({"role": "assistant",  "content": reply})

        # Trim context to MAX_CTX_MSGS (keep most recent)
        if len(context_msgs) > MAX_CTX_MSGS:
            context_msgs = context_msgs[-MAX_CTX_MSGS:]

        # Avisar cada 10 turnos que la sesión lleva tiempo
        _repl_turn += 1
        if _repl_turn % 10 == 0:
            print(_c(DIM, f"  ℹ  {_repl_turn} turnos en esta sesión. Escribí /compact para liberar contexto."))

        print()

    _sb_teardown()
    # Bug real 5/9 (reporte de usuario real): al salir queda toda
    # la charla vieja en el scroll de la terminal — molesto para deslizar y para
    # copiar (queda el marco de los bloques). Limpiar pantalla real (no solo el
    # contexto de la conversación, eso ya lo hace /clear) antes del mensaje final.
    sys.stdout.write("\x1b[2J\x1b[H")
    sys.stdout.flush()
    print(_c(DIM, "Hasta luego."))
    con.close()


# ── Entry point ───────────────────────────────────────────────────────────────
if __name__ == "__main__":
    if "--selftest" in sys.argv:
        sys.exit(_selftest())
    new_session = "--new" in sys.argv
    repl(new_session=new_session)
