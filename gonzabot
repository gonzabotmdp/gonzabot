                                    else:
                                        # patch aplicó con indentación incorrecta — reintentar con ajuste
                                        _shutil_br.copy2(src_path, bpath)
                                        patched2 = _apply_diff_by_context(
                                            src_path.read_text(encoding="utf-8"), fixed_diff
                                        )
                                        if patched2 is not None:
                                            bpath.write_text(patched2, encoding="utf-8")
                                            rc2 = _sp3.run(
                                                ["python3", "-m", "py_compile", str(bpath)],
                                                capture_output=True, text=True
                                            )
                                            if rc2.returncode == 0:
                                                print(_c(GRN, f"  {bname} → sintaxis OK (indentación corregida)"))
                                                ready.append((idx, bpath, bpath))
                                            else:
                                                print(_c(RED, f"  {bname} → ERROR de sintaxis:"))
                                                print(_c(DIM, rc2.stderr[:400]))
                                        else:
                                            print(_c(RED, f"  {bname} → ERROR de sintaxis:"))
                                            print(_c(DIM, rc.stderr[:400]))
                                else:
                                    ready.append((idx, bpath, bpath))
                        else:
                            print(_c(RED, f"  {bname} → ERROR de patch:"))
                            print(_c(DIM, (r.stdout + r.stderr)[:400]))
                else:
                    # Modo script completo (archivos cortos)
                    fence = lang_cfg["fence"]
                    code_blocks = _re.findall(
                        rf"```(?:{fence})?\n(.*?)```", reply_br, _re.DOTALL
                    )
                    if not code_blocks:
                        print(_c(YEL, f"\nNo encontré bloques ```{fence}``` en la respuesta."))
                        print(_c(DIM, f"Pedile al bot que regenere con formato ```{fence}```"))
                        continue
                    for idx, code in enumerate(code_blocks, 1):
                        bname = f"branch_{idx}{lang_cfg['ext']}"
                        bpath = branch_dir / bname
                        bpath.write_text(code, encoding="utf-8")
                        saved.append(bpath)
                        if lang_cfg["compile"] is not None:
                            binpath = branch_dir / f"branch-bin-{idx}"
