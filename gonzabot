def _restore_terminal():
    """Restaurar terminal a estado original — llamado por atexit y señales."""
    try:
        if sys.stdout.isatty():
            sys.stdout.write(
                "\x1b[?2004l"   # deshabilitar bracketed paste
                "\x1b[r"        # reset scrolling region
                "\x1b[0m"       # reset colores
            )
            if _ALTSCREEN_ACTIVE:
                sys.stdout.write("\x1b[?1049l")  # salir del alternate screen
            sys.stdout.write("\r\n")
            sys.stdout.flush()
    except Exception:
        pass
    try:
        if _ORIG_TERM_ATTRS is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSANOW, _ORIG_TERM_ATTRS)
    except Exception:
        pass


