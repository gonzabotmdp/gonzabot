def _warmup():
    """Manda un request mínimo para compilar kernels CUDA antes del primer uso real."""
    import threading
    def _run():
        try:
            payload = json.dumps({
                "model": MODEL, "messages": [{"role": "user", "content": "ok"}],
                "stream": False, "max_tokens": 1, "temperature": 0.0,
            }).encode("utf-8")
            req = Request(f"{VLLM_BASE}/chat/completions", data=payload,
                          headers={"Content-Type": "application/json"}, method="POST")
            with urlopen(req, timeout=30):
                pass
        except Exception:
            pass
    threading.Thread(target=_run, daemon=True).start()


