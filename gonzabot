# ── SQLite history ─────────────────────────────────────────────────────────────
def init_db() -> sqlite3.Connection:
    DB_DIR.mkdir(parents=True, exist_ok=True)
    # Set permissions so only the owner can read the DB
    DB_DIR.chmod(0o700)
    con = sqlite3.connect(DB_PATH)
    DB_PATH.chmod(0o600)
    con.execute("""
        CREATE TABLE IF NOT EXISTS messages (
            id        INTEGER PRIMARY KEY AUTOINCREMENT,
            session   TEXT    NOT NULL,
            ts        TEXT    NOT NULL,
            role      TEXT    NOT NULL,
            content   TEXT    NOT NULL
        )
    """)
    con.execute("CREATE INDEX IF NOT EXISTS idx_session ON messages(session, id)")
    con.commit()
    return con


def new_session_id() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S")


def save_message(con: sqlite3.Connection, session: str, role: str, content: str):
    con.execute(
        "INSERT INTO messages (session, ts, role, content) VALUES (?, ?, ?, ?)",
        (session, datetime.now().isoformat(), role, content)
    )
    con.commit()


def load_recent_messages(con: sqlite3.Connection, n: int = MAX_CTX_MSGS) -> list[dict]:
    """Return the last n user/assistant messages across all sessions."""
    rows = con.execute(
        "SELECT role, content FROM messages WHERE role IN ('user','assistant') "
        "ORDER BY id DESC LIMIT ?", (n,)
    ).fetchall()
    return [{"role": r, "content": c} for r, c in reversed(rows)]


def show_history(con: sqlite3.Connection, n: int = 5):
    rows = con.execute(
        "SELECT session, ts, role, content FROM messages "
        "WHERE role IN ('user','assistant') "
        "ORDER BY id DESC LIMIT ?", (n * 4,)
    ).fetchall()
    if not rows:
        print(_c(DIM, "No history yet."))
        return
    sessions: dict[str, list] = {}
    for session, ts, role, content in reversed(rows):
        sessions.setdefault(session, []).append((ts, role, content))

    for sid, msgs in list(sessions.items())[-n:]:
        print(_c(BOLD, f"\n── Session {sid} ──"))
        for ts, role, content in msgs:
            prefix = _c(CYAN, "A:") if role == "assistant" else _c(GRN, "U:")
            snippet = content[:120].replace("\n", " ")
            if len(content) > 120:
                snippet += "…"
            print(f"  {prefix} {snippet}")


def search_history(con: sqlite3.Connection, query: str,
                   extra_context: list[str], max_chars: int = 30000):
    """Search history by keyword(s) or load a session by ID into context."""
    import re as _re
    is_session_id = bool(_re.match(r'^\d{8}-\d{6}$', query))

    if is_session_id:
        rows = con.execute(
            "SELECT ts, role, content FROM messages WHERE session = ? ORDER BY id",
            (query,)
        ).fetchall()
        if not rows:
            print(_c(YEL, f"Sesión {query} no encontrada."))
            return
        print(_c(BOLD, f"\n── Sesión {query} ({len(rows)} mensajes) ──"))
        parts = [f"=== Historial sesión {query} ==="]
        for ts, role, content in rows:
            label = "USUARIO" if role == "user" else "GONZABOT"
            prefix = _c(CYAN, "A:") if role == "assistant" else _c(GRN, "U:")
            snippet = content[:200].replace("\n", " ") + ("…" if len(content) > 200 else "")
            print(f"  [{ts[:19]}] {prefix} {snippet}")
            parts.append(f"[{ts[:19]}] {label}: {content}")
        full_text = "\n".join(parts)
        if len(full_text) > max_chars:
            full_text = full_text[:max_chars] + "\n[... truncado]"
        extra_context.append(f"[Historial de sesión {query}]\n{full_text}")
        print(_c(GRN, f"\n✓ Sesión cargada como contexto ({len(full_text):,} chars)"))
        return

    # Keyword search — AND between all words
    keywords = query.split()
    where = " AND ".join(["content LIKE ?"] * len(keywords))
    params = [f"%{k}%" for k in keywords]
    rows = con.execute(
        f"SELECT session, ts, role, content FROM messages WHERE {where} ORDER BY id",
        params
    ).fetchall()
    if not rows:
        print(_c(YEL, f"No encontré mensajes con: {query}"))
        return

    sessions_found: dict[str, list] = {}
    for session, ts, role, content in rows:
        sessions_found.setdefault(session, []).append((ts, role, content))

    print(_c(BOLD, f"\n── Búsqueda \"{query}\" — {len(rows)} msgs en "
              f"{len(sessions_found)} sesión(es) ──"))
    parts = [f"=== Historial: búsqueda \"{query}\" ==="]
    total = len(parts[0])
    truncated = False
    for session, msgs in sessions_found.items():
        print(_c(BOLD, f"\n  Sesión {session}:"))
        hdr = f"\n=== Sesión {session} ==="
        parts.append(hdr); total += len(hdr)
        for ts, role, content in msgs:
            label = "USUARIO" if role == "user" else "GONZABOT"
            prefix = _c(CYAN, "A:") if role == "assistant" else _c(GRN, "U:")
            snippet = content[:150].replace("\n", " ") + ("…" if len(content) > 150 else "")
            print(f"    {prefix} {snippet}")
            line = f"[{ts[:19]}] {label}: {content}"
            if not truncated and total + len(line) <= max_chars:
                parts.append(line); total += len(line)
            elif not truncated:
                parts.append("[... truncado por límite de contexto]")
                truncated = True

    full_text = "\n".join(parts)
    extra_context.append(f"[Historial relevante: {query}]\n{full_text}")
    print(_c(GRN, f"\n✓ Resultados cargados como contexto ({len(full_text):,} chars)"))
    if len(sessions_found) > 1:
        print(_c(DIM, "  Tip: /history <session_id> para cargar una sola sesión"))


# ── Context file ──────────────────────────────────────────────────────────────
def _run_dynamic_context() -> str:
    """Queries live cluster state at session start. Kept short to avoid context overflow."""
    sections = []

    def _run(cmd, timeout=8, label=None, maxchars=300):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            out = r.stdout.strip()
            if out:
                if len(out) > maxchars:
                    out = out[:maxchars] + "... [truncado]"
                sections.append(f"[{label}]\n{out}")
        except Exception:
            pass

    # Info del usuario actual
    _run(["id", _USERNAME], label=f"grupos de {_USERNAME}", maxchars=200)
    _run(["squeue", "-u", _USERNAME, "-o", "%i %j %P %C %m %T %R", "--noheader"],
         label=f"jobs actuales de {_USERNAME} (vacío = sin jobs en cola)", maxchars=300)

    # Todos los jobs del cluster (para responder squeue sin inventar)
    _run(["squeue", "-o", "%i %P %j %u %T %.10M %D %R", "--noheader"],
         label="squeue completo del cluster (todos los usuarios, al inicio de sesión)", maxchars=800)

    # Cluster node status (compact)
    _run(["sinfo", "-o", "%P %a %D %t", "--noheader"], label="sinfo (particion/nodos/estado)", maxchars=400)

    # Spack: paquetes instalados explícitamente con versión y hash corto
    # -x = solo explícitos (no deps automáticas), ~90 paquetes vs 1400 del árbol completo
    _run(["spack", "find", "-x", "--format", "{name}@{version}/{hash:8}"], timeout=12,
         label="spack packages instalados — para usar en sbatch ver PATRÓN A/B en core.txt; NUNCA eval $(spack load --sh) sin SPACK_USER_CACHE_PATH", maxchars=2500)

    # Disk usage (solo las columnas esenciales)
    _run(["df", "-h", "--output=target,used,avail,pcent",
          "/data/home", "/mnt/cpu-data", "/mnt/gpu-data"],
         label="disco", maxchars=300)

    if not sections:
        return ""
    return "\n\n".join(sections)


