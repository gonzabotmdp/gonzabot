def _init_context() -> None:
    """Carga segmentos de contexto en memoria. Llamar una vez al inicio de sesión."""
    global _CTX_DYNAMIC
    for name, _rx in _SEGMENTS:
        _CTX[name] = ""
        # Preferir variante -dev si existe, sino la de producción
        for candidate in [CONTEXT_DIR / f"{name}-dev.txt", CONTEXT_DIR / f"{name}.txt"]:
            try:
                if candidate.exists():
                    _CTX[name] = candidate.read_text(encoding="utf-8")
                    break
            except (PermissionError, OSError):
                continue
        else:
            # Fallback monolítico legacy (solo para core)
            if name == "core":
                try:
                    _CTX[name] = Path(CONTEXT_FILE).read_text(encoding="utf-8")
                except (PermissionError, OSError):
                    _CTX[name] = ""

    dynamic = _run_dynamic_context()
    if dynamic:
        _CTX_DYNAMIC = f"\n\n--- INFO EN VIVO (al iniciar sesión) ---\n{dynamic}\n--- FIN INFO EN VIVO ---"

    # Contexto personal del usuario (~/.gonzabot/context.txt)
    personal = Path.home() / ".gonzabot" / "context.txt"
    if personal.exists():
        try:
            personal_txt = personal.read_text(encoding="utf-8").strip()
            if personal_txt:
                _CTX_DYNAMIC += f"\n\n--- CONTEXTO PERSONAL DE {_USERNAME} ---\n{personal_txt[:2000]}\n--- FIN CONTEXTO PERSONAL ---"
        except OSError:
            pass


def _ctx_for_probe(probe: str, include_python: bool = True) -> str:
    """Arma el bloque de contexto para un texto dado: core siempre, el resto
    solo si su regex matchea. Usado tanto por el chat normal (_system_prompt_for)
    como por /diagnose (que sondea logs en vez de un mensaje de usuario)."""
    ctx = _CTX.get("core", "")
    for name, rx in _SEGMENTS:
        if name == "core":
            continue
        if name == "python" and not include_python:
            continue
        if rx and rx.search(probe) and _CTX.get(name):
            ctx += "\n\n" + _CTX[name]
    return ctx


def _system_prompt_for(user_message: str = "", history: str = "") -> str:
    """Construye el system prompt cargando solo los segmentos relevantes.

    Sondea el mensaje actual Y el historial reciente: en conversaciones largas
    los follow-ups ("eso falló, ¿no hay otra forma?") no repiten las keywords
    pero las reglas del cluster siguen haciendo falta (bug reparado 13 jul 2026)."""
    probe = user_message + "\n" + history
    ctx = _ctx_for_probe(probe, include_python=True) + _CTX_DYNAMIC
    if _RE_QUEUE_OPT.search(user_message):
        ctx += _fresh_queue_snapshot()
    return _BASE_PROMPT + ctx


def load_system_prompt() -> str:
    """Compatibilidad: devuelve el prompt con TODOS los segmentos (para /audit,
    /compact, /queue, /branch check — comandos sin un mensaje de usuario puntual
    contra el que sondear triggers)."""
    parts = [_CTX[name] for name, _ in _SEGMENTS if _CTX.get(name)]
    return _BASE_PROMPT + "\n\n".join(parts) + _CTX_DYNAMIC


