def _vlen(s: str) -> int:
    import re
    return len(re.sub(r'\033\[[0-9;]*m', '', s))


def _yn_raw(prompt_text: str) -> bool:
    """Confirmación de un solo caracter (s/y = sí, cualquier otra = no). Sin Enter."""
    sys.stdout.write(prompt_text)
    sys.stdout.flush()
    if not sys.stdin.isatty():
        line = sys.stdin.readline().strip().lower()
        return line in ("s", "y")
    fd = sys.stdin.fileno()
    ch = ""
    try:
        old = termios.tcgetattr(fd)
        # Descartar type-ahead: si el usuario ya tipeó otro comando (ej. "sbatch ..."),
        # su primera letra NO debe interpretarse como respuesta a esta confirmación
        termios.tcflush(fd, termios.TCIFLUSH)
        tty.setraw(fd)
        ch = os.read(fd, 1).decode("utf-8", errors="replace")
    except Exception:
        pass
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        except Exception:
            pass
    display = ch if (ch.isprintable() and ch) else ("^C" if ch == "\x03" else "n")
    sys.stdout.write(display + "\r\n")
    sys.stdout.flush()
    return ch.lower() in ("s", "y")


def _yn_line(prompt_text: str) -> bool:
    """Confirmación estricta para operaciones destructivas: exige 's' + Enter.

    A diferencia de _yn_raw (1 char crudo), acá un comando tipeado por error
    ("sbatch ...") NUNCA confirma — solo la línea exacta 's' o 'y' (bug 13 jul 2026)."""
    sys.stdout.write(prompt_text)
    sys.stdout.flush()
    try:
        if sys.stdin.isatty():
            termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
        line = input().strip().lower()
    except (EOFError, KeyboardInterrupt):
        return False
    return line in ("s", "y", "si", "sí", "yes")


