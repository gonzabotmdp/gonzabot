                            except OSError:
                                pass
                    if not branch_logs:
                        print(_c(YEL, f"No encontré logs de branches para el job {check_jid} en {home}"))
                        continue
                    all_logs = "\n\n".join(branch_logs)
                    check_prompt = (
                        f"Estos son los resultados de un experimento de branches.\n\n"
